{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection-install-approvals/v1",
  "title": "Collection exact-revision install approvals",
  "type": "object",
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "collection-install-approvals/v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "revision_sha",
          "license",
          "decision",
          "install_approval",
          "integration_gate",
          "security_gate",
          "integration_evidence",
          "security_evidence",
          "capability_key",
          "reviewed_at",
          "review_notes"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "revision_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "enum": [
              "MIT",
              "Apache-2.0",
              "BSD-2-Clause",
              "BSD-3-Clause",
              "ISC",
              "MPL-2.0",
              "Unlicense",
              "0BSD"
            ]
          },
          "decision": {
            "enum": [
              "INSTALL_APPROVED",
              "REVIEW_REQUIRED",
              "REJECTED"
            ]
          },
          "install_approval": {
            "enum": [
              "APPROVED",
              "NOT_APPROVED"
            ]
          },
          "integration_gate": {
            "enum": [
              "PASS",
              "UNVERIFIED",
              "FAIL"
            ]
          },
          "security_gate": {
            "enum": [
              "PASS",
              "UNVERIFIED",
              "FAIL"
            ]
          },
          "integration_evidence": {
            "type": "string",
            "pattern": "^https://github\\.com/.+/actions/runs/[0-9]+$"
          },
          "security_evidence": {
            "type": "string",
            "pattern": "^https://github\\.com/.+/actions/runs/[0-9]+$"
          },
          "capability_key": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_notes": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
