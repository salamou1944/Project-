{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collection-readiness-declaration/v1",
  "title": "Collection Readiness Declaration",
  "type": "object",
  "required": [
    "capability_key",
    "state",
    "source_revisions",
    "license_boundary",
    "dependencies",
    "config_schema",
    "activation_recipe",
    "smoke_test",
    "evidence_refs"
  ],
  "properties": {
    "capability_key": {"type":"string","minLength":1},
    "state": {
      "enum": [
        "READY_ON_DEMAND",
        "READY_TO_USE",
        "INTEGRATED",
        "TESTED",
        "HUMAN_READY",
        "PRODUCTION_PROVEN"
      ]
    },
    "source_revisions": {"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "license_boundary": {"type":"string","minLength":1},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "config_schema": {"type":"object"},
    "activation_recipe": {"type":"array","items":{"type":"string"},"minItems":1},
    "smoke_test": {
      "type":"object",
      "required":["command","expected_result"],
      "properties":{
        "command":{"type":"string","minLength":1},
        "expected_result":{"type":"string","minLength":1}
      },
      "additionalProperties":true
    },
    "evidence_refs": {"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "known_limitations": {"type":"array","items":{"type":"string"}},
    "external_blockers": {"type":"array","items":{"type":"string"}},
    "execution_evidence": {
      "type":"object",
      "required":["timestamp","environment","result_ref","revision"],
      "properties":{
        "timestamp":{"type":"string","minLength":1},
        "environment":{"type":"string","minLength":1},
        "result_ref":{"type":"string","minLength":1},
        "revision":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }
  },
  "allOf": [
    {
      "if":{"properties":{"state":{"const":"READY_TO_USE"}}},
      "then":{"required":["execution_evidence"]}
    },
    {
      "if":{"properties":{"state":{"enum":["INTEGRATED","TESTED","HUMAN_READY","PRODUCTION_PROVEN"]}}},
      "then":{"required":["execution_evidence"]}
    }
  ],
  "additionalProperties":false
}
