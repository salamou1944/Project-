{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Collection Extraction Ready Packet",
  "type":"object",
  "required":["extraction_id","source","source_revision","file","asset_type","content_sha256","handoff_status","readiness_state"],
  "properties":{
    "extraction_id":{"type":"string"},
    "source":{"type":"string"},
    "source_revision":{"type":"string"},
    "source_license":{"type":["string","null"]},
    "file":{"type":"string"},
    "asset_type":{"type":"string"},
    "content_sha256":{"type":"string"},
    "handoff_status":{"const":"READY_FOR_DEDUPE"},
    "readiness_state":{"const":"ON_SHELF"}
  },
  "additionalProperties":true
}
