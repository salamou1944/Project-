      "path": "tests/test_client_metadata.py",
      "sha": "b7b813e2f908bcbc26723364e160bdf1ed8c5b3c",
      "bucket": "contract",
      "source_content_sha256": "6ded7dedadcd84948a0ce4e2f1c63950cd23f166b359fed40b07d85164862316",
      "content_sha256": "6ded7dedadcd84948a0ce4e2f1c63950cd23f166b359fed40b07d85164862316",
