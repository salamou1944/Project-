      "content": "\"\"\"Idempotent collection, index, and validator provisioning.\n\nCollections follow the specification's data model:\n\n* ``state_snapshots`` — serialized engine states (``to_bytes`` blobs).\n* ``memory_items`` — structured memory (engine-synced items and\n  LangGraph ``BaseStore`` items share one collection and one guard).\n* ``literal_cache`` — verbatim entries for exact text recall.\n* ``compliance_events`` — append-only event store (shape enforced by a\n  JSON-schema validator; append-only is enforced by role separation in\n  Atlas and by ``MongoEventStore``, which never updates in place).\n* ``deletion_certificates`` — signed Art. 17 forget certificates.\n* ``tenants`` — per-tenant configuration (embedder model/dimension,\n  fusion weights, retention).\n\n``provision()`` may be called at every service start: existing\ncollections, indexes, and search indexes are left untouched.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport contextlib\nimport logging\nfrom typing import Any\n\nfrom pymongo.database import Database\nfrom pymongo.errors import CollectionInvalid, OperationFailure\n\nfrom semvec_atlas.client_metadata import announce\n\nlogger = logging.getLogger(__name__)\n\n#: Business records that live beside the memory collections and may be\n#: written inside a turn's transaction (see ``commit.DomainWrite``).\n#:\n#: This tuple is an allowlist, not an inventory. ``domain_writes`` is a\n#: generic upsert primitive driven by caller-supplied names, so without\n#: a closed set it would reach ``compliance_events`` — a log whose whole\n#: value is that only the event store appends to it.\n#:\n#: Domain records are scoped to the **tenant**, not to (tenant, agent):\n#: several specialist agents work the same case, and binding a claim to\n#: whichever agent opened it would hide it from the rest.\nDOMAIN_COLLECTIONS = (\n    \"claims\",\n    \"policies\",\n)\n\n#: The multi-agent coordination layer's mirror (see ``cortex_store``).\nCORTEX_COLLECTIONS = (\n    \"cortex_agents\",\n    \"cortex_observations\",\n    \"cortex_proposals\",\n)\n\nCOLLECTIONS = (\n    \"state_snapshots\",\n    \"memory_items\",\n    \"literal_cache\",\n    \"compliance_events\",\n    \"deletion_certificates\",\n    \"tenants\",\n    \"quarantined_inputs\",\n    \"firewall_anchors\",\n    *DOMAIN_COLLECTIONS,\n    *CORTEX_COLLECTIONS,\n)\n\n# Insert *shape* of one compliance event. Mirrors semvec's MemoryEvent\n# (event_id, created_at, content, embedding, meta, source_event_id) plus\n# the Atlas-side partition (tenant, agent) and the monotonic seq the\n# adapter assigns.\n_EVENT_VALIDATOR: dict[str, Any] = {\n    \"$jsonSchema\": {\n        \"bsonType\": \"object\",\n        \"required\": [\n            \"tenant\",\n            \"agent\",\n            \"seq\",\n            \"event_id\",\n            \"created_at\",\n            \"content\",\n            \"embedding\",\n            \"meta\",\n        ],\n        \"properties\": {\n            \"tenant\": {\"bsonType\": \"string\", \"minLength\": 1},\n            \"agent\": {\"bsonType\": \"string\", \"minLength\": 1},\n            \"seq\": {\"bsonType\": [\"int\", \"long\"], \"minimum\": 1},\n            \"event_id\": {\"bsonType\": \"string\", \"minLength\": 1},\n            \"created_at\": {\"bsonType\": [\"date\", \"string\"]},\n            \"content\": {\"bsonType\": \"string\"},\n            \"embedding\": {\"bsonType\": \"array\"},\n            \"meta\": {\"bsonType\": \"object\"},\n            \"source_event_id\": {\"bsonType\": [\"string\", \"null\"]},\n        },\n    }\n}\n\n\ndef _ensure_collection(db: Database, name: str, **opts: Any) -> None:\n    # Idempotent: an existing collection is the expected steady state.\n    with contextlib.suppress(CollectionInvalid):\n        db.create_collection(name, **opts)\n\n\ndef _ensure_search_index(collection, model: dict[str, Any]) -> None:\n    existing = {ix[\"name\"] for ix in collection.list_search_indexes()}\n    if model[\"name\"] in existing:\n        return\n    try:\n        collection.create_search_index(model)\n    except OperationFailure as exc:  # pragma: no cover - race on parallel start\n        if \"already exists\" not in str(exc).lower():\n            raise\n\n\ndef provision(\n    db: Database,\n    *,\n    dimension: int,\n    search_indexes: bool = True,\n    ttl_short_seconds: int | None = None,\n) -> None:\n    \"\"\"Create all collections, validators, and indexes. Safe to re-run.\n\n    ``dimension`` is the tenant's embedder dimension (the vector\n    index runs on client-side embeddings). ``ttl_short_seconds``\n    arms the TTL safety net on evicted short-tier items;\n    ``None`` leaves TTL disarmed.\n    \"\"\"\n    announce(db.client)\n    for name in COLLECTIONS:\n        if name == \"compliance_events\":\n            _ensure_collection(db, name, validator=_EVENT_VALIDATOR)\n        else:\n            _ensure_collection(db, name)\n\n    # --- standard indexes (create_index is idempotent by definition) ---\n    db.memory_items.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"ns\", 1), (\"key\", 1)],\n        name=\"ix_ns\",\n        unique=True,\n        partialFilterExpression={\"deleted\": False},\n    )\n    db.state_snapshots.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"session\", 1), (\"turn\", -1)],\n        name=\"ix_snap\",\n        unique=True,\n    )\n    db.compliance_events.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"seq\", 1)],\n        name=\"ix_evt\",\n        unique=True,\n    )\n    db.literal_cache.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"memory_id\", 1)],\n        name=\"ix_lit\",\n    )\n    db.deletion_certificates.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"created_at\", -1)],\n        name=\"ix_cert\",\n    )\n    db.quarantined_inputs.create_index(\n        [(\"tenant\", 1), (\"agent\", 1), (\"status\", 1), (\"created_at\", -1)],\n        name=\"ix_qi\",\n    )\n    # Anchors are tenant-wide by design (inoculation) — no agent key.\n    db.firewall_anchors.create_index(\n        [(\"tenant\", 1), (\"created_at\", -1)],\n        name=\"ix_fwa\",\n    )\n    # Domain records: tenant-wide, unique per business key, so every\n    # agent of the tenant reaches the same document and a repeated\n    # upsert updates rather than duplicates.\n    db.claims.create_index(\n        [(\"tenant\", 1), (\"claim_id\", 1)],\n        name=\"ix_claim\",\n        unique=True,\n    )\n    db.policies.create_index(\n        [(\"tenant\", 1), (\"policy_number\", 1)],\n        name=\"ix_policy\",\n        unique=True,\n    )\n    # Cortex mirror: participation is one row per (case, agent);\n    # readings and decisions are series, read oldest-first per case.\n    db.cortex_agents.create_index(\n        [(\"tenant\", 1), (\"case\", 1), (\"instance_id\", 1)],\n        name=\"ix_cortex_agent\",\n        unique=True,\n    )\n    db.cortex_observations.create_index(\n        [(\"tenant\", 1), (\"case\", 1), (\"recorded_at\", 1)],\n        name=\"ix_cortex_obs\",\n    )\n    # Unique: a recorded decision must not be rewritten under its own id.\n    db.cortex_proposals.create_index(\n        [(\"tenant\", 1), (\"proposal_id\", 1)],\n        name=\"ix_cortex_prop\",\n        unique=True,\n    )\n    if ttl_short_seconds is not None:\n        db.memory_items.create_index(\n            [(\"updated_at\", 1)],\n            name=\"ix_ttl\",\n            expireAfterSeconds=ttl_short_seconds,\n            partialFilterExpression={\"tier\": \"short\", \"evicted\": True},\n        )\n\n    # --- Atlas Search / Vector Search indexes ---\n    if search_indexes:\n        _ensure_search_index(\n            db.memory_items,\n            {\n                \"name\": \"ix_vec\",\n                \"type\": \"vectorSearch\",\n                \"definition\": {\n                    \"fields\": [\n                        {\n                            \"type\": \"vector\",\n                            \"path\": \"embedding\",\n                            \"numDimensions\": dimension,\n                            \"similarity\": \"cosine\",\n                        },\n                        {\"type\": \"filter\", \"path\": \"tenant\"},\n                        {\"type\": \"filter\", \"path\": \"agent\"},\n                        {\"type\": \"filter\", \"path\": \"tier\"},\n                        {\"type\": \"filter\", \"path\": \"evicted\"},\n                        {\"type\": \"filter\", \"path\": \"deleted\"},\n                    ]\n                },\n            },\n        )\n        _ensure_search_index(\n            db.memory_items,\n            {\n                \"name\": \"ix_lex\",\n                \"type\": \"search\",\n                \"definition\": {\n                    \"mappings\": {\n                        \"dynamic\": False,\n                        \"fields\": {\n                            \"summary\": {\n                                \"type\": \"string\",\n                                \"analyzer\": \"lucene.german\",\n                                \"multi\": {\n                                    \"standard\": {\n                                        \"type\": \"string\",\n                                        \"analyzer\": \"lucene.standard\",\n                                    }\n                                },\n                            },\n                            \"tenant\": {\"type\": \"token\"},\n                            \"agent\": {\"type\": \"token\"},\n                            \"deleted\": {\"type\": \"boolean\"},\n                            \"evicted\": {\"type\": \"boolean\"},\n                        },\n                    }\n                },\n            },\n        )\n        logger.info(\"search indexes ensured on memory_items (dim=%d)\", dimension)\n"
    },
    {
      "path": "src/semvec_atlas/mcp.py",
      "sha": "9282668113c762b1ffd2c85fcce448ddd420f8d3",
      "bucket": "agent",
      "source_content_sha256": "a602ee6e97b21e8b8a007d2c1201f0f2337c94b54a874210f637c39eade3ec26",
      "content_sha256": "a602ee6e97b21e8b8a007d2c1201f0f2337c94b54a874210f637c39eade3ec26",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "\"\"\"MCP tools for the Atlas backend.\n\nStructure mirrors the wheel's ``semvec.coding.mcp_server``: plain\n``handle_*`` functions carry the logic and are unit-testable without a\ntransport; ``create_atlas_mcp_server`` wraps them as FastMCP tools.\n\nTool names use underscores per MCP identifier rules; the specification's\ndotted names map 1:1: ``memory.search`` → ``memory_search``,\n``memory.forget`` → ``memory_forget``, ``memory.audit`` → ``memory_audit``.\n\n``memory_forget`` deliberately requires an explicit ``reason`` — an\nArt. 17 wipe is an audited business action, never a side effect.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom typing import Any\n\nfrom pymongo.database import Database\n\nfrom semvec_atlas.client_metadata import announce\nfrom semvec_atlas.compliance import AtlasForget\nfrom semvec_atlas.firewall import QuarantineVault\nfrom semvec_atlas.guard import TenantScope\nfrom semvec_atlas.retrieval import RetrievalEngine\n\n__all__ = [\n    \"create_atlas_mcp_server\",\n    \"handle_audit\",\n    \"handle_firewall_status\",\n    \"handle_forget\",\n    \"handle_quarantine_list\",\n    \"handle_quarantine_release\",\n    \"handle_search\",\n]\n\n\ndef handle_search(\n    db: Database,\n    scope: TenantScope,\n    embedder: Any,\n    *,\n    query: str,\n    k: int = 8,\n    force_fallback: bool = False,\n) -> str:\n    \"\"\"Hybrid retrieval over the scope's memory items (JSON result).\"\"\"\n    engine = RetrievalEngine.for_tenant(\n        db, scope, embedder=embedder, force_fallback=force_fallback\n    )\n    hits = engine.search(query, k=k)\n    return json.dumps(\n        {\n            \"path\": \"rankFusion\" if engine.uses_rank_fusion else \"clientRRF\",\n            \"weights\": engine.weights,\n            \"hits\": [\n                {\n                    \"key\": h.key,\n                    \"summary\": h.summary,\n                    \"tier\": h.tier,\n                    \"ns\": h.ns,\n                    \"score\": h.score,\n                }\n                for h in hits\n            ],\n        }\n    )\n\n\ndef handle_forget(\n    db: Database,\n    scope: TenantScope,\n    *,\n    reason: str,\n    priv_pem: bytes | None = None,\n) -> str:\n    \"\"\"Execute an Art. 17 forget for the scope; returns the certificate summary.\"\"\"\n    cert = AtlasForget(db, scope, priv_pem=priv_pem).forget_all(reason=reason)\n    return json.dumps(\n        {\n            \"user_id\": cert.user_id,\n            \"event_count\": cert.event_count,\n            \"deleted_at\": cert.deleted_at.isoformat(),\n            \"reason\": cert.reason,\n            \"issuer\": cert.issuer,\n            \"signature_b64\": cert.signature_b64,\n        }\n    )\n\n\ndef handle_audit(\n    db: Database, scope: TenantScope, *, pub_pem: bytes | None = None\n) -> str:\n    \"\"\"Return the verified deletion-certificate chain (read-only).\"\"\"\n    chain = AtlasForget(db, scope).audit(pub_pem=pub_pem)\n    return json.dumps(\n        {\n            \"user_id\": scope.user_id,\n            \"certificates\": [\n                {\n                    \"reason\": e.reason,\n                    \"request_reason\": e.request_reason,\n                    \"issuer\": e.issuer,\n                    \"event_count\": e.event_count,\n                    \"deleted_at\": e.deleted_at.isoformat(),\n                    \"signature_b64\": e.signature_b64,\n                    \"valid\": e.valid,\n                }\n                for e in chain\n            ],\n        }\n    )\n\n\ndef handle_firewall_status(db: Database, scope: TenantScope) -> str:\n    \"\"\"Content-free firewall observability (JSON result).\n\n    Reports the tenant's anchor catalog with provenance (who learned\n    what, correlated via ``text_hash`` — never text, never vectors)\n    plus the held-quarantine count, so an operator can see the fleet's\n    current immunity at a glance.\n    \"\"\"\n    tenant_scope = TenantScope(tenant=scope.tenant)\n    anchors = [\n        {\n            \"anchor_id\": doc[\"_id\"],\n            \"kind\": doc[\"kind\"],\n            \"agent\": (doc.get(\"provenance\") or {}).get(\"agent\"),\n            \"text_hash\": doc.get(\"text_hash\"),\n            \"created_at\": doc[\"created_at\"].isoformat(),\n        }\n        for doc in db.firewall_anchors.find(\n            tenant_scope.filter(), projection={\"embedding\": False}\n        ).sort(\"created_at\", 1)\n    ]\n    counts: dict[str, int] = {}\n    for a in anchors:\n        counts[a[\"kind\"]] = counts.get(a[\"kind\"], 0) + 1\n    held = db.quarantined_inputs.count_documents(\n        scope.filter({\"status\": \"held\"})\n    )\n    return json.dumps(\n        {\n            \"quarantine\": {\"held\": held},\n            \"anchor_counts\": counts,\n            \"anchors\": anchors,\n        }\n    )\n\n\ndef handle_quarantine_list(db: Database, scope: TenantScope) -> str:\n    \"\"\"Content-free listing of firewall-held inputs (JSON result).\n\n    Never exposes the held text or embedding — preview is redaction-\n    capped, correlation runs over the SHA-256 hash.\n    \"\"\"\n    entries = QuarantineVault(db, scope).list()\n    return json.dumps(\n        {\n            \"entries\": [\n                {\n                    \"quarantine_id\": e[\"_id\"],\n                    \"text_preview\": e[\"text_preview\"],\n                    \"text_hash\": e[\"text_hash\"],\n                    \"score\": e[\"score\"],\n                    \"reason\": e[\"reason\"],\n                    \"level\": e[\"level\"],\n                    \"session\": e[\"session\"],\n                    \"turn\": e[\"turn\"],\n                    \"status\": e[\"status\"],\n                }\n                for e in entries\n            ]\n        }\n    )\n\n\ndef handle_quarantine_release(\n    db: Database, scope: TenantScope, *, quarantine_id: str, reason: str\n) -> str:\n    \"\"\"Release a held input; returns the full text for re-commit.\n\n    A release is an audited human decision (``reason`` is mandatory,\n    like ``memory_forget``); the caller re-ingests the returned text\n    as a regular turn. Unknown/double releases report an error.\n    \"\"\"\n    try:\n        doc = QuarantineVault(db, scope).release(quarantine_id, reason=reason)\n    except KeyError as exc:\n        return json.dumps({\"error\": str(exc)})\n    return json.dumps(\n        {\n            \"quarantine_id\": quarantine_id,\n            \"text\": doc[\"text\"],\n            \"status\": \"released\",\n            \"release_reason\": reason,\n        }\n    )\n\n\ndef create_atlas_mcp_server(\n    db: Database,\n    scope: TenantScope,\n    *,\n    embedder: Any,\n    priv_pem: bytes | None = None,\n    pub_pem: bytes | None = None,\n):\n    \"\"\"Build the FastMCP server exposing the three Atlas memory tools.\"\"\"\n    from fastmcp import FastMCP\n\n    announce(db.client)\n\n    mcp = FastMCP(\n        \"semvec-atlas\",\n        instructions=(\n            \"Semvec Atlas Edition memory tools. memory_search runs hybrid \"\n            \"retrieval; memory_forget executes a signed GDPR Art. 17 wipe \"\n            \"for this agent's memory stream; memory_audit returns the \"\n            \"verified deletion-certificate chain.\"\n        ),\n    )\n\n    @mcp.tool()\n    def memory_search(query: str, k: int = 8) -> str:\n        \"\"\"Hybrid search (semantic + lexical + recency) over agent memory.\"\"\"\n        return handle_search(db, scope, embedder, query=query, k=k)\n\n    @mcp.tool()\n    def memory_forget(reason: str) -> str:\n        \"\"\"GDPR Art. 17: wipe this agent's memory stream, return signed certificate.\"\"\"\n        return handle_forget(db, scope, reason=reason, priv_pem=priv_pem)\n\n    @mcp.tool()\n    def memory_audit() -> str:\n        \"\"\"Return the verified deletion-certificate chain for this agent.\"\"\"\n        return handle_audit(db, scope, pub_pem=pub_pem)\n\n    @mcp.tool()\n    def memory_quarantine_list() -> str:\n        \"\"\"List firewall-held inputs (content-free: preview + hash only).\"\"\"\n        return handle_quarantine_list(db, scope)\n\n    @mcp.tool()\n    def memory_quarantine_release(quarantine_id: str, reason: str) -> str:\n        \"\"\"Release a held input (audited decision); returns its text for re-commit.\"\"\"\n        return handle_quarantine_release(\n            db, scope, quarantine_id=quarantine_id, reason=reason\n        )\n\n    @mcp.tool()\n    def memory_firewall_status() -> str:\n        \"\"\"Tenant firewall status: anchor catalog with provenance, held count (content-free).\"\"\"\n        return handle_firewall_status(db, scope)\n\n    return mcp\n"
    },
    {
      "path": "benchmarks/run_locomo_atlas.py",
      "sha": "2126a1f12b950b78209f137b0b3118f454f91f53",
