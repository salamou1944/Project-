      "content": "\"\"\"Shared test fixtures for semvec-atlas.\n\nTests marked ``mongo`` require the local ``mongodb/mongodb-atlas-local``\ncontainer (MongoDB 8.3+, single-node replica set, Atlas Search enabled)::\n\n    docker run -d --name semvec-atlas-mongo -p 27017:27017 \\\n        mongodb/mongodb-atlas-local:latest\n\nEach test gets a private database (UUID-suffixed) that is dropped on\nteardown — tests never share state.\n\nThe semvec license key is read from the repository root ``.env``\n(``SEMVEC_KEY``) and exported as ``SEMVEC_LICENSE_KEY`` before the first\n``semvec`` import, mirroring production deployment (key injected via\nenvironment, never hard-coded).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport uuid\nfrom pathlib import Path\n\nimport numpy as np\nimport pytest\n\n# ---------------------------------------------------------------------------\n# License key: map .env SEMVEC_KEY -> SEMVEC_LICENSE_KEY before importing\n# semvec anywhere. Walk up from this file so the fixture works from any cwd.\n\n\ndef _load_license_key() -> None:\n    if os.environ.get(\"SEMVEC_LICENSE_KEY\"):\n        return\n    for parent in Path(__file__).resolve().parents:\n        env_file = parent / \".env\"\n        if env_file.is_file():\n            for line in env_file.read_text().splitlines():\n                if line.startswith(\"SEMVEC_KEY=\"):\n                    os.environ[\"SEMVEC_LICENSE_KEY\"] = line.split(\"=\", 1)[1].strip()\n                    return\n\n\n_load_license_key()\n\nMONGO_URI = os.environ.get(\n    \"SEMVEC_ATLAS_TEST_URI\", \"mongodb://localhost:27017/?directConnection=true\"\n)\n\nEMBED_DIM = 32\n\n\nclass DeterministicEmbedder:\n    \"\"\"Test embedder fulfilling the semvec ``EmbedderProtocol``.\n\n    Vectors are a pure function of the input text (SHA-256 seeded RNG,\n    L2-normalised), so persistence and retrieval tests are reproducible\n    without a model download. Semantic *quality* is irrelevant here —\n    these tests exercise storage, transactions, and query plumbing.\n    \"\"\"\n\n    def get_dimension(self) -> int:\n        return EMBED_DIM\n\n    def get_embedding(self, text: str) -> np.ndarray:\n        seed = int.from_bytes(hashlib.sha256(text.encode()).digest()[:8], \"big\")\n        rng = np.random.default_rng(seed)\n        v = rng.standard_normal(EMBED_DIM)\n        return v / np.linalg.norm(v)\n\n\n@pytest.fixture(scope=\"session\")\ndef embedder() -> DeterministicEmbedder:\n    return DeterministicEmbedder()\n\n\n@pytest.fixture(scope=\"session\")\ndef mongo_client():\n    pymongo = pytest.importorskip(\"pymongo\")\n    client = pymongo.MongoClient(MONGO_URI, serverSelectionTimeoutMS=5000)\n    try:\n        client.admin.command(\"ping\")\n    except Exception:  # pragma: no cover - environment guard\n        pytest.skip(f\"MongoDB not reachable at {MONGO_URI}\")\n    yield client\n    client.close()\n\n\n@pytest.fixture()\ndef db(mongo_client):\n    \"\"\"A private, empty database per test, dropped on teardown.\"\"\"\n    name = f\"svatest_{uuid.uuid4().hex[:12]}\"\n    database = mongo_client[name]\n    yield database\n    mongo_client.drop_database(name)\n\n\n@pytest.fixture()\ndef fresh_state():\n    \"\"\"A small-dimension SemvecState factory (engine from the wheel).\"\"\"\n    from semvec import SemvecConfig, SemvecState\n\n    def make(dimension: int = EMBED_DIM) -> SemvecState:\n        return SemvecState(SemvecConfig(dimension=dimension))\n\n    return make\n"
    },
    {
      "path": "tests/test_calibration.py",
      "sha": "49727a4be3e390b2b1dbe2de5afb6d8194850bf5",
      "bucket": "eval",
      "source_content_sha256": "5b27fa4db6fccda453f090a6db6afa83ace13bdc482ec1d16b9d6aecfb30ebb5",
      "content_sha256": "5b27fa4db6fccda453f090a6db6afa83ace13bdc482ec1d16b9d6aecfb30ebb5",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "\"\"\"Firewall thresholds are a measurement, not a constant.\n\nThe gate compares an incoming turn against exclusion anchors and blocks\nabove a cosine threshold. That number is a property of the *embedder*:\ntwo models place the same pair of sentences at different distances, so\na threshold measured for one is meaningless for another. Copying it\nacross silently is how a firewall stops blocking without erroring.\n\nSo thresholds live in a registry of calibrated profiles, each carrying\nthe separation it was derived from, and an embedder with no profile is\nrefused rather than defaulted. :func:`calibrate_threshold` performs the\nmeasurement — it is the same routine that produced the shipped\nprofile, which is what makes the shipped number reproducible.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport pytest\n\nfrom semvec_atlas.firewall import (\n    CALIBRATED_PROFILES,\n    CalibrationError,\n    ThresholdProfile,\n    calibrate_threshold,\n    threshold_for,\n)\n\nMPNET = \"sentence-transformers/all-mpnet-base-v2\"\n\n\nclass TestProfileRegistry:\n    def test_mpnet_profile_is_the_measured_one(self):\n        profile = CALIBRATED_PROFILES[MPNET]\n        assert isinstance(profile, ThresholdProfile)\n        assert profile.threshold == pytest.approx(0.45)\n\n    def test_profile_records_the_separation_it_came_from(self):\n        \"\"\"A threshold without its margin is an unfalsifiable number.\"\"\"\n        profile = CALIBRATED_PROFILES[MPNET]\n        benign_max, attack_min = profile.separation\n        assert benign_max < profile.threshold < attack_min\n\n    def test_threshold_for_known_model(self):\n        assert threshold_for(MPNET) == pytest.approx(0.45)\n\n    def test_unknown_model_is_refused_not_defaulted(self):\n        \"\"\"Fail closed: an uncalibrated model must not inherit a number.\n\n        ``voyage-3.5`` is the deliberate example — it is the model this\n        package will want as its default, and it has not been measured\n        yet (the calibration run needs a Voyage API key). When someone\n        registers that profile this test fails, which is the intended\n        reminder to update it rather than a false alarm.\n        \"\"\"\n        with pytest.raises(CalibrationError) as exc:\n            threshold_for(\"voyage-3.5\")\n        assert \"calibrate\" in str(exc.value).lower()\n\n\nclass TestCalibration:\n    \"\"\"The measurement routine, exercised with a separable toy embedder.\"\"\"\n\n    class _Embedder:\n        \"\"\"Two clusters: 'attack …' near one axis, everything else near another.\"\"\"\n\n        DIM = 8\n\n        def get_dimension(self) -> int:\n            return self.DIM\n\n        def get_embedding(self, text: str):\n            import numpy as np\n\n            v = np.zeros(self.DIM, dtype=float)\n            if text.startswith(\"attack\"):\n                v[0] = 1.0\n                v[1] = 0.08 * (len(text) % 5)\n            else:\n                v[2] = 1.0\n                v[3] = 0.08 * (len(text) % 5)\n            return v / np.linalg.norm(v)\n\n    ANCHORS = [\"attack anchor one\", \"attack anchor two\"]\n    ATTACKS = [\"attack variant alpha\", \"attack variant beta gamma\"]\n    BENIGN = [\"ordinary business sentence\", \"another routine remark here\"]\n\n    def test_threshold_lands_between_the_two_clusters(self):\n        profile = calibrate_threshold(\n            self._Embedder(),\n            anchors=self.ANCHORS,\n            attacks=self.ATTACKS,\n            benign=self.BENIGN,\n            model=\"toy-model\",\n        )\n        benign_max, attack_min = profile.separation\n        assert benign_max < profile.threshold < attack_min\n        assert profile.model == \"toy-model\"\n\n    def test_inseparable_corpus_raises_instead_of_guessing(self):\n        \"\"\"No margin means no honest threshold — say so rather than pick one.\"\"\"\n        with pytest.raises(CalibrationError) as exc:\n            calibrate_threshold(\n                self._Embedder(),\n                anchors=self.ANCHORS,\n                # A \"benign\" sample that is really an attack: the clusters\n                # now overlap and no cut separates them.\n                attacks=self.ATTACKS,\n                benign=[*self.BENIGN, \"attack disguised as benign\"],\n                model=\"toy-model\",\n            )\n        assert \"separat\" in str(exc.value).lower()\n\n    def test_empty_sample_is_refused(self):\n        with pytest.raises(CalibrationError):\n            calibrate_threshold(\n                self._Embedder(),\n                anchors=self.ANCHORS,\n                attacks=[],\n                benign=self.BENIGN,\n                model=\"toy-model\",\n            )\n"
    },
    {
      "path": "tests/test_commit.py",
      "sha": "e2f0ad2917efbc6abb669353fcad09ecc4df6f37",
      "bucket": "eval",
      "source_content_sha256": "3c0d671d59a7e5301fb997fc353a3a19df294cc8ae9da2c6996d0448621fe8d7",
      "content_sha256": "3c0d671d59a7e5301fb997fc353a3a19df294cc8ae9da2c6996d0448621fe8d7",
      "redaction_applied": false,
