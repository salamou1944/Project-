      "content": "{\n    \"private\": true,\n    \"name\": \"@duckdb/duckdb-wasm-examples-esbuild-browser\",\n    \"version\": \"0.0.1\",\n    \"main\": \"index.js\",\n    \"license\": \"MIT\",\n    \"dependencies\": {\n        \"@duckdb/duckdb-wasm\": \"file:../../packages/duckdb-wasm\"\n    },\n    \"devDependencies\": {\n        \"esbuild\": \"^0.20.2\",\n        \"http-server\": \"^14.1.1\",\n        \"serve\": \"^14.2.1\",\n        \"typescript\": \"^5.3.3\"\n    },\n    \"scripts\": {\n        \"build\": \"node ./bundle.mjs && tsc --noEmit\",\n        \"server\": \"http-server\",\n        \"server-threads\": \"serve\"\n    }\n}\n"
