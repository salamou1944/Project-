      "source_content_sha256": "c8726c2857c58a93cec1a1403ce528b268194358598cd7dcdcae195b39f355dc",
      "content_sha256": "c8726c2857c58a93cec1a1403ce528b268194358598cd7dcdcae195b39f355dc",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "name: 'NPM tag'\non:\n    workflow_call:\n      inputs:\n        version:\n          type: string\n        tag:\n          type: string\n    workflow_dispatch:\n      inputs:\n        version:\n          type: string\n        tag:\n          type: string\n\njobs:\n    change_tags:\n        name: Change tags\n        runs-on: ubuntu-latest\n        steps:\n            - uses: actions/checkout@v6\n              with:\n                  submodules: 'recursive'\n                  fetch-depth: 0\n\n            - uses: actions/setup-node@v6\n              with:\n                  node-version: '18.x'\n                  registry-url: 'https://registry.npmjs.org'\n\n            - name: Change tags\n              env:\n                  TAG: ${{ inputs.tag }}\n                  VERSION: ${{ inputs.version }}\n              run: |\n                  npm dist-tag ls @duckdb/duckdb-wasm@\"${VERSION}\"\n                  npm dist-tag add @duckdb/duckdb-wasm@\"${VERSION}\" \"${TAG}\"\n                  npm dist-tag ls @duckdb/duckdb-wasm@\"${VERSION}\"\n"
    },
    {
      "path": "actions/image/action.yml",
      "sha": "cf5325fd4f5e656366bb1c1727df5774edca3b5e",
      "bucket": "ops",
      "source_content_sha256": "d7d35b951a07efe2d08c4868329d9aa9e831a6132197ffd35b58c9709b702a8c",
      "content_sha256": "d7d35b951a07efe2d08c4868329d9aa9e831a6132197ffd35b58c9709b702a8c",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "inputs:\n    # The build script\n    script:\n        description: 'script to be passed to the docker image'\n        required: true\n\n    # The cache directories.\n    # Default to global cache directories in the runner home directory.\n    emscripten_cache:\n        description: 'emscripten cache directory'\n        default: /home/actions/.emscripten_cache\n    yarn_cache:\n        description: 'yarn cache directory'\n        default: /home/actions/.yarn_cache\n    ccache:\n        description: 'ccache directory'\n        default: /home/actions/.ccache\n\nruns:\n    using: 'composite'\n    steps:\n        # Build the CI image\n        - run: |-\n              export CI_IMAGE_TAG=`cat ./actions/image/TAG`\n              [ ! -z `docker images -q duckdb/wasm-ci:${CI_IMAGE_TAG}` ] || \\\n                  docker build \\\n                      -t duckdb/wasm-ci:${CI_IMAGE_TAG} \\\n                      -f ${{ github.workspace }}/actions/image/Dockerfile \\\n                      .\n          shell: bash\n\n        # Run the script inside the image\n        - run: |-\n              export CI_IMAGE_TAG=`cat ./actions/image/TAG`\n              docker run --rm \\\n                  -v ${{ github.workspace }}:/wd/ \\\n                  -v ${{ inputs.emscripten_cache }}:/mnt/emscripten_cache/ \\\n                  -v ${{ inputs.yarn_cache }}:/mnt/yarn_cache/ \\\n                  -v ${{ inputs.ccache }}:/mnt/ccache/ \\\n                  -e EM_CACHE=/mnt/emscripten_cache \\\n                  -e YARN_CACHE_FOLDER=/mnt/yarn_cache \\\n                  -e CCACHE_DIR=/mnt/ccache \\\n                  -e CCACHE_BASEDIR=/wd/ \\\n                  duckdb/wasm-ci:${CI_IMAGE_TAG} \\\n                  bash -c \"${{ inputs.script }}\"\n          shell: bash\n"
    },
