      "path": ".github/workflows/main.yml",
      "sha": "ccf37298388e95b4f1abaf016a66c0f89334fe61",
      "bucket": "eval",
      "source_content_sha256": "c5141479cf6e892658157622d9afcb56dd23f307dba732f0c3b333c48e8c4bb9",
      "content_sha256": "c5141479cf6e892658157622d9afcb56dd23f307dba732f0c3b333c48e8c4bb9",
      "redaction_applied": false,
