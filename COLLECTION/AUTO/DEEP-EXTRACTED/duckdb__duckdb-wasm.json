      "content": "import * as duckdb from '@duckdb/duckdb-wasm';\nimport * as arrow from 'apache-arrow';\nimport path from 'path';\nimport { createRequire } from 'module';\n\nconst require = createRequire(import.meta.url);\nconst DUCKDB_DIST = path.dirname(require.resolve('@duckdb/duckdb-wasm'));\nconst Worker = require('web-worker');\n\n(async () => {\n    try {\n        const DUCKDB_CONFIG = await duckdb.selectBundle({\n            base: {\n                mainModule: path.resolve(DUCKDB_DIST, './duckdb-base.wasm'),\n                mainWorker: path.resolve(DUCKDB_DIST, './duckdb-node-base.worker.cjs'),\n            },\n        });\n\n        const logger = new duckdb.ConsoleLogger();\n        const worker = new Worker(DUCKDB_CONFIG.mainWorker!);\n        const db = new duckdb.AsyncDuckDB(logger, worker);\n        await db.instantiate(DUCKDB_CONFIG.mainModule, DUCKDB_CONFIG.pthreadWorker);\n\n        const conn = await db.connect();\n        await conn.query<{ v: arrow.Int }>(`SELECT count(*)::INTEGER as v FROM generate_series(0, 100) t(v)`);\n\n        await conn.close();\n        await db.terminate();\n        await worker.terminate();\n    } catch (e) {\n        console.error(e);\n    }\n})();\n"
    },
