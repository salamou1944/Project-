      "content": "[package]\nname = \"dataprep\"\nversion = \"0.1.0\"\nauthors = [\"Andre Kohn <kohn.a@outlook.com>\"]\nedition = \"2018\"\n\n[dependencies]\nchrono = { version = \"0.4.19\", features = [\"serde\"] }\nserde = { version = \"1.0.130\", features = [\"derive\"] }\nserde_json = \"1.0\"\nparquet = \"13.0.0\"\narrow = { version = \"13.0.0\", features = [\"csv\", \"ipc\"] }\nclap = \"3.0.0-beta.2\"\n"
