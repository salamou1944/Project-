      "path": ".github/workflows/test.yml",
      "sha": "1f7c9ee00508cdb598f4903260bb185969c10e8b",
      "bucket": "eval",
      "source_content_sha256": "ed1ca030e6a914908c18e03c62af142505d385d71dde56bf5ffa10f5b9f33e7e",
