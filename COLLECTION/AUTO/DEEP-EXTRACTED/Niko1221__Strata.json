      "content": "import test from 'node:test';\r\nimport assert from 'node:assert/strict';\r\nimport {mergeWindows} from './windows.ts';\r\nconst w=(start:number,end:number)=>({start,end});\r\ntest('empty',()=>assert.deepEqual(mergeWindows([]),[]));\r\ntest('one',()=>assert.deepEqual(mergeWindows([w(1,2)]),[w(1,2)]));\r\ntest('sort input',()=>assert.deepEqual(mergeWindows([w(5,6),w(1,2)]),[w(1,2),w(5,6)]));\r\ntest('overlap',()=>assert.deepEqual(mergeWindows([w(1,4),w(3,7)]),[w(1,7)]));\r\ntest('touching',()=>assert.deepEqual(mergeWindows([w(1,3),w(3,5)]),[w(1,5)]));\r\ntest('containment',()=>assert.deepEqual(mergeWindows([w(1,10),w(2,3),w(8,12)]),[w(1,12)]));\r\ntest('same start',()=>assert.deepEqual(mergeWindows([w(1,8),w(1,3)]),[w(1,8)]));\r\ntest('duplicate',()=>assert.deepEqual(mergeWindows([w(1,2),w(1,2)]),[w(1,2)]));\r\ntest('exact gap',()=>assert.deepEqual(mergeWindows([w(1,2),w(4,5)],2),[w(1,5)]));\r\ntest('outside gap',()=>assert.deepEqual(mergeWindows([w(1,2),w(4,5)],1),[w(1,2),w(4,5)]));\r\ntest('gap chains',()=>assert.deepEqual(mergeWindows([w(8,9),w(1,2),w(4,6)],2),[w(1,9)]));\r\ntest('negative coordinates',()=>assert.deepEqual(mergeWindows([w(-4,-1),w(-2,3)]),[w(-4,3)]));\r\ntest('fractional coordinates',()=>assert.deepEqual(mergeWindows([w(.5,1.25),w(1.5,2)],.25),[w(.5,2)]));\r\ntest('zero length',()=>assert.deepEqual(mergeWindows([w(2,2),w(1,2)]),[w(1,2)]));\r\ntest('frozen input',()=>{const a=Object.freeze([Object.freeze(w(3,5)),Object.freeze(w(1,4))]); assert.deepEqual(mergeWindows(a as any),[w(1,5)]);});\r\ntest('new objects and unchanged input',()=>{const a=[w(3,5),w(1,4)]; const old=structuredClone(a);const b=mergeWindows(a);assert.deepEqual(a,old);assert.ok(b.every(x=>!a.includes(x)));});\r\nfor(const gap of [-1,NaN,Infinity,-Infinity]) test('bad gap '+gap,()=>assert.throws(()=>mergeWindows([],gap),RangeError));\r\nfor(const pair of [[2,1],[NaN,1],[0,Infinity],[-Infinity,0],[0,NaN]]) test('bad window '+pair,()=>assert.throws(()=>mergeWindows([w(pair[0],pair[1])]),RangeError));\r\n"
    },
    {
      "path": "docs/bench-results/2026-10-10-community-rx-9060-xt/fixtures/refactor-orders/acceptance.test.ts",
      "sha": "814f7d6f89dc7fca87c4e96dcfa2dd579c5a2595",
      "bucket": "eval",
      "source_content_sha256": "d09b3c3217069d714f982fe6bd3910f153a24172dbbd2b2d08fc145a75838e07",
      "content_sha256": "d09b3c3217069d714f982fe6bd3910f153a24172dbbd2b2d08fc145a75838e07",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "import test from 'node:test';\r\nimport assert from 'node:assert/strict';\r\nimport {summarizeOrders} from './orders.ts';\r\nconst o=(customer:string,priceCents=100,quantity=1,cancelled=false)=>({customer,priceCents,quantity,cancelled});\r\ntest('empty',()=>assert.deepEqual(summarizeOrders([]),[]));\r\ntest('single',()=>assert.deepEqual(summarizeOrders([o('a',125,2)]),[{customer:'a',totalCents:250,units:2}]));\r\ntest('grouping',()=>assert.deepEqual(summarizeOrders([o('b',100,2),o('a',50,3),o('b',25,1)]),[{customer:'a',totalCents:150,units:3},{customer:'b',totalCents:225,units:3}]));\r\ntest('trim and group',()=>assert.deepEqual(summarizeOrders([o(' a ',30),o('a',20)]),[{customer:'a',totalCents:50,units:2}]));\r\ntest('cancelled ignored',()=>assert.deepEqual(summarizeOrders([o('a',100,1,true)]),[]));\r\ntest('case sensitive',()=>assert.deepEqual(summarizeOrders([o('a'),o('A')]).map(x=>x.customer),['A','a']));\r\ntest('zero price',()=>assert.equal(summarizeOrders([o('a',0,4)])[0].units,4));\r\ntest('frozen input',()=>{const a=Object.freeze([Object.freeze(o(' b ')),Object.freeze(o('a'))]);assert.equal(summarizeOrders(a as any)[1].customer,'b');});\r\ntest('unchanged input',()=>{const a=[o(' b '),o('a')];const old=structuredClone(a);summarizeOrders(a);assert.deepEqual(a,old);});\r\ntest('invalid array',()=>assert.throws(()=>summarizeOrders(null as any),RangeError));\r\nfor(const invalid of [o(''),o(' '),o('a',-1),o('a',1.5),o('a',NaN),o('a',Infinity),o('a',100,0),o('a',100,-1),o('a',100,1.5),{...o('a'),cancelled:'yes'},null]) test('invalid '+JSON.stringify(invalid),()=>assert.throws(()=>summarizeOrders([invalid] as any),RangeError));\r\ntest('invalid cancelled record still rejected',()=>assert.throws(()=>summarizeOrders([o('a',-1,1,true)]),RangeError));\r\ntest('exported validation helper',async()=>{const {validateOrders}=await import('./validation.ts');const a=[o(' a ',2,3)];const r=validateOrders(a);assert.equal(r[0].customer,'a');assert.notEqual(r[0],a[0]);assert.equal(a[0].customer,' a ');assert.throws(()=>validateOrders([o('',1)]),RangeError);});\r\ntest('exported aggregation helper',async()=>{const {aggregateOrders}=await import('./aggregation.ts');const a=Object.freeze([Object.freeze(o('b',2,3)),Object.freeze(o('a',4)),Object.freeze(o('a',10,1,true))]);assert.deepEqual(aggregateOrders(a as any),[{customer:'a',totalCents:4,units:1},{customer:'b',totalCents:6,units:3}]);});\r\n"
    },
    {
      "path": "app/host/tests/model-providers-history-images.test.mjs",
      "sha": "4fb970283db64fbc0fc6d28b4981662e4b16bf6d",
      "bucket": "media",
      "source_content_sha256": "04ca61b2e6920361b52b0ee40fa84179a1570195a57b66f70441b61a7aaa714a",
      "content_sha256": "04ca61b2e6920361b52b0ee40fa84179a1570195a57b66f70441b61a7aaa714a",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "import test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { mkdtempSync, rmSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { createModelProviders } from '../server/model-providers.mjs';\nconst PNG = 'data:image/png;base64,iVBORw0KGgo=';\nconst WEBP = 'data:image/webp;base64,UklGRg==';\nconst text = value => ({ type: 'text', text: value });\nconst image = url => ({ type: 'image_url', image_url: { url } });\nfunction setup(t, { protocol = 'openai-chat', vision = true } = {}) {\n  const directory = mkdtempSync(join(tmpdir(), 'strata-provider-history-'));\n  t.after(() => rmSync(directory, { recursive: true, force: true }));\n  const requests = [];\n  const fetchImpl = async (url, options) => {\n    requests.push({ url, body: JSON.parse(options.body) });\n    const events = protocol === 'anthropic'\n      ? [{ type: 'content_block_delta', delta: { text: 'ok' } }, { type: 'message_stop' }]\n      : protocol === 'openai-responses'\n        ? [{ type: 'response.output_text.delta', delta: 'ok' }, { type: 'response.completed', response: {} }]\n        : [{ choices: [{ index: 0, delta: { content: 'ok' }, finish_reason: null }] }, { choices: [{ index: 0, delta: {}, finish_reason: 'stop' }] }];\n    return new Response(events.map(e => `data: ${JSON.stringify(e)}\\n\\n`).join(''), { headers: { 'content-type': 'text/event-stream' } });\n  };\n  const service = createModelProviders({ directory, fetchImpl });\n  const connection = service.save({ kind: 'custom', name: 'Local API', baseUrl: 'http://127.0.0.1:9/v1', protocol,\n    models: ['model-a', 'model-b'].map(id => ({ id, vision })) }).connections[0];\n  const send = (options = {}) => service.stream({ selection: { connectionId: connection.id, modelId: 'model-a' }, message: 'What color was it?', onFrame: () => {}, ...options });\n  return { service, connection, send, requests };\n}\n\ntest('UI-format image history survives model changes without a current attachment', async t => {\n  const { service, connection, requests } = setup(t);\n  const history = [{ role: 'user', content: [text('What is in this picture?'), image(PNG)] }, { role: 'assistant', content: 'A red shape.' }];\n  const original = structuredClone(history);\n  for (const modelId of ['model-a', 'model-b', 'model-a']) {\n    const frames = [];\n    await service.stream({ selection: { connectionId: connection.id, modelId }, message: 'Which shape was red?', history, images: [], onFrame: frame => frames.push(frame) });\n    const body = requests.at(-1).body;\n    assert.equal(body.model, modelId);\n    assert.deepEqual(body.messages, [...history, { role: 'user', content: 'Which shape was red?' }]);\n    assert.equal(frames.at(-1).type, 'done');\n  }\n  assert.equal(requests.length, 3);\n  assert.deepEqual(history, original, 'normalization must not mutate stored UI messages');\n});\n\ntest('history and current pictures retain order and do not duplicate pixels', async t => {\n  const { send, requests } = setup(t);\n  await send({ history: [{ role: 'user', content: [text('Earlier question'), image(PNG), text('Earlier detail')] }], images: [{ url: WEBP }] });\n  const messages = requests[0].body.messages;\n  assert.deepEqual(messages[0].content, [text('Earlier question'), image(PNG), text('Earlier detail')]);\n  assert.deepEqual(messages[1].content, [text('What color was it?'), image(WEBP)]);\n});\n\ntest('only supported blocks and user image roles are forwarded; the question remains', async t => {\n  const { send, requests } = setup(t);\n  await send({ history: [null, { role: 'system', content: 'Not a user-supplied system instruction' }, { role: 'tool', content: 'ignored' },\n    { role: 'user', content: [null, 3, [], { type: 'text', text: 7 }, { type: 'input_text', text: 'unsupported' },\n      { type: 'text', text: 'Keep this question', unexpected: 'discard' }, { type: 'image_url', image_url: { url: PNG, unexpected: 'discard' }, unexpected: true }] },\n    { role: 'assistant', content: [text('Keep this answer'), image('file:///not-forwarded')] }, { role: 'user', content: [{ type: 'audio', data: 'discard' }] }] });\n  assert.deepEqual(requests[0].body.messages.slice(0, -1), [\n    { role: 'user', content: [text('Keep this question'), image(PNG)] }, { role: 'assistant', content: 'Keep this answer' }]);\n});\n\ntest('explicit text-only models keep historical questions without sending pictures', async t => {\n  const { send, requests } = setup(t, { vision: false });\n  await send({ history: [{ role: 'user', content: [text('Question'), image(PNG), text('Extra detail')] }] });\n  assert.deepEqual(requests[0].body.messages[0], { role: 'user', content: 'Question\\nExtra detail' });\n});\n\ntest('unknown vision retains the existing pictures-on default', async t => {\n  const { send, requests } = setup(t, { vision: null });\n  await send({ history: [{ role: 'user', content: [text('Question'), image(PNG)] }] });\n  assert.deepEqual(requests[0].body.messages[0].content, [text('Question'), image(PNG)]);\n});\n\nfor (const protocol of ['openai-responses', 'anthropic']) test(`${protocol} keeps array-history text without image blocks`, async t => {\n  const { send, requests } = setup(t, { protocol });\n  await send({ history: [{ role: 'user', content: [text('Question'), image(PNG), text('Extra detail')] }] });\n  assert.deepEqual((requests[0].body.messages ?? requests[0].body.input)[0], { role: 'user', content: 'Question\\nExtra detail' });\n});\n\nfor (const protocol of ['openai-chat', 'openai-responses', 'anthropic']) test(`${protocol} string history keeps exact content, roles and the last 40 entries`, async t => {\n  const { send, requests } = setup(t, { protocol });\n  const history = Array.from({ length: 45 }, (_, i) => ({ role: i % 2 ? 'assistant' : 'user', content: i === 44 ? '' : `  unchanged ${i}\\n` }));\n  history.splice(8, 0, { role: 'system', content: 'ignored' }, { role: 'user', content: 12 });\n  await send({ history });\n  const expected = history.filter(m => ['user', 'assistant'].includes(m.role) && typeof m.content === 'string').slice(-40).map(m => ({ role: m.role, content: m.content }));\n  assert.deepEqual((requests[0].body.messages ?? requests[0].body.input).slice(0, -1), expected);\n});\n\n// GUI-1116 fix-up: an earlier picture never stops the chat. One that cannot be sent is left out (a remote or file address never goes out)\n// and its words stay; with more than four pictures in all, the newest are kept.\ntest('malformed, remote and unsupported historical image URLs are left out; their words stay and the chat goes on', async t => {\n  const { send, requests } = setup(t);\n  const blocks = [{ type: 'image_url' }, { type: 'image_url', image_url: null }, image('file:///secret'), image('https://example.com/image.png'), image('data:image/gif;base64,R0lG'), image('data:image/png;base64,%%%')];\n  for (const block of blocks) {\n    await send({ history: [{ role: 'user', content: [text('Keep the question'), block] }, { role: 'assistant', content: 'It was red.' }] });\n    const sent = requests.at(-1).body.messages;\n    assert.deepEqual(sent.slice(0, 2), [{ role: 'user', content: 'Keep the question' }, { role: 'assistant', content: 'It was red.' }], JSON.stringify(block));\n    assert.ok(!JSON.stringify(sent).includes('secret') && !JSON.stringify(sent).includes('example.com'));\n  }\n  assert.equal(requests.length, blocks.length);\n});\n\ntest('an earlier picture over 6 MB is left out, and with more than four pictures in all the newest are kept', async t => {\n  const { send, requests } = setup(t);\n  const tooLarge = 'data:image/png;base64,' + Buffer.alloc(6 * 1024 * 1024 + 1).toString('base64');\n  await send({ history: [{ role: 'user', content: [text('Question'), image(tooLarge)] }] });\n  assert.deepEqual(requests.at(-1).body.messages[0], { role: 'user', content: 'Question' });\n  const older = 'data:image/png;base64,iVBORw0KGgoA', newer = WEBP;\n  await send({ history: [{ role: 'user', content: [text('First'), image(older), image(older)] }, { role: 'assistant', content: 'ok' }, { role: 'user', content: [text('Second'), image(newer)] }],\n    images: [{ url: PNG }, { url: PNG }, { url: PNG }] });\n  const sent = requests.at(-1).body.messages;\n  const pictures = sent.flatMap(m => Array.isArray(m.content) ? m.content.filter(p => p.type === 'image_url').map(p => p.image_url.url) : []);\n  assert.deepEqual(pictures, [newer, PNG, PNG, PNG], 'four in all: the three of this message and the newest earlier one');\n  assert.deepEqual(sent[0], { role: 'user', content: 'First' }, 'the oldest message keeps its words');\n  await send({ history: [{ role: 'user', content: [text('Q'), image(PNG), image(PNG)] }], images: [{ url: PNG }, { url: PNG }, { url: PNG }, { url: PNG }] });\n  assert.deepEqual(requests.at(-1).body.messages[0], { role: 'user', content: 'Q' }, 'four new pictures leave no room for earlier ones');\n  assert.equal(requests.length, 3);\n});\n"
    },
    {
      "path": "app/host/tests/runtime-api.test.mjs",
      "sha": "a1259f5bdaf3125e7bdf494c084325b3307daa79",
      "bucket": "contract",
      "source_content_sha256": "3039e675272da03e2cd06fba2cbe976cd9ec2705be350685c983a23ca909742b",
      "content_sha256": "3039e675272da03e2cd06fba2cbe976cd9ec2705be350685c983a23ca909742b",
      "redaction_applied": false,
      "redaction_reasons": [],
      "content": "import { ROOMY_HOST } from './helpers/hardware.mjs';\nimport { fileURLToPath } from 'node:url';\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport {spawn} from 'node:child_process';\nimport {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises';\nimport {tmpdir} from 'node:os';\nimport {join} from 'node:path';\nimport {createServer} from 'node:net';\nconst delay=ms=>new Promise(resolve=>setTimeout(resolve,ms));\nasync function freePort(){const server=createServer();await new Promise(r=>server.listen(0,'127.0.0.1',r));const port=server.address().port;await new Promise(r=>server.close(r));return port;}\ntest('HTTP gateway lists all models, routes both protocols exactly, and isolates lifecycle requests',{timeout:30000},async()=>{\n const home=await mkdtemp(join(tmpdir(),'strata-multiple-model-test-'));await mkdir(join(home,'data'));\n await writeFile(join(home,'data','state.json'),JSON.stringify({installed:{'qwen38-q4_k_m':{installedAt:'2026-10-14',simulated:true},'qwen36-q4_k_m':{installedAt:'2026-10-14',simulated:true}}}));\n const port=await freePort(),base=`http://127.0.0.1:${port}`;\n const host=spawn(process.execPath,['server/index.mjs'],{cwd:fileURLToPath(new URL('..',import.meta.url)),env:{...process.env,STRATA_HOME:home,STRATA_MODELS_DIR:join(home,'models'),STRATA_REAL_ENGINE:'0',STRATA_TEST_HARDWARE:ROOMY_HOST,STRATA_PORT:String(port),STRATA_BIND:'127.0.0.1'},stdio:'ignore'});\n async function call(path,body){const response=await fetch(base+path,{method:body===undefined?'GET':'POST',headers:{'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return {status:response.status,body:await response.json()};}\n try{\n  let ready=false;for(let i=0;i<80;i++){try{ready=(await call('/api/runtime')).status===200;if(ready)break;}catch{}await delay(100);}assert.ok(ready,'test host started');\n  const engine=(await call('/api/engine')).body;\n  const config={beginner:{...engine.beginner,contextLength:'32k'},expert:engine.expert.map(p=>({id:p.id,value:p.id==='ctx.length'?'32K':p.value})),extra:{headroom:'shared'}};\n  const hardware=(await call('/api/hardware')).body;\n  const a=await call('/api/runtime/load',{variantId:'qwen38-q4_k_m',gpuIds:hardware.gpus.map(g=>g.id??`${g.vendor}:${g.index}`),config,executionMode:'multiple'});assert.equal(a.status,200,JSON.stringify(a.body));\n  const b=await call('/api/runtime/load',{variantId:'qwen36-q4_k_m',gpuIds:[],config,executionMode:'multiple'});assert.equal(b.status,200,JSON.stringify(b.body));\n  const list=(await call('/v1/models')).body.data;assert.equal(list.length,2);assert.deepEqual(new Set(list.map(i=>i.id)),new Set([a.body.instance.apiModelId,b.body.instance.apiModelId]));\n  assert.equal((await call('/v1/chat/completions',{model:'missing',messages:[{role:'user',content:'hello'}]})).status,409);\n  assert.equal((await call('/v1/messages',{messages:[{role:'user',content:'hello'}]})).status,409);\n  assert.equal((await call('/v1/v1/messages',{messages:[{role:'user',content:'hello'}]})).status,409,'an Anthropic client given the /v1 base reaches the same route');\n  assert.notEqual((await call('/v1/v1/chat/completions',{model:'missing',messages:[{role:'user',content:'hello'}]})).status,409,'only the messages path is aliased');\n  const controllers=[new AbortController(),new AbortController()];\n  const responseA=await fetch(base+'/v1/chat/completions',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({stream:true,model:a.body.instance.apiModelId,messages:[{role:'user',content:'hello'}]}),signal:controllers[0].signal});\n  const responseB=await fetch(base+'/v1/messages',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({stream:true,model:b.body.instance.apiModelId,messages:[{role:'user',content:'hello'}]}),signal:controllers[1].signal});\n  assert.equal(responseA.status,200);assert.equal(responseB.status,200);\n  const state=(await call('/api/serving')).body;assert.equal(state.stats.running,2);assert.deepEqual(new Set(state.requests.map(r=>r.instanceId)),new Set([a.body.instance.id,b.body.instance.id]));\n  assert.equal((await call(`/api/runtime/${a.body.instance.id}/unload`,{})).status,409);\n  for(const request of state.requests)await call(`/api/serving/requests/${request.id}/cancel`,{});\n  controllers.forEach(c=>c.abort());\n  for(let i=0;i<30;i++){if(!(await call('/api/serving')).body.stats.running)break;await delay(100);}\n  await call(`/api/runtime/${a.body.instance.id}/unload`,{});\n  assert.equal((await call('/v1/models')).body.data[0].id,b.body.instance.apiModelId);\n  assert.equal((await call('/api/runtime')).body.instances.length,1);\n  const switched=await call('/api/runtime/load',{variantId:'qwen38-q4_k_m',gpuIds:[],config});assert.equal(switched.status,200,JSON.stringify(switched.body));\n  assert.equal(switched.body.state.instances.length,1);assert.equal(switched.body.state.instances[0].variantId,'qwen38-q4_k_m');assert.equal(switched.body.state.defaultId,switched.body.instance.id);\n  const legacy=await call('/api/models/qwen36-q4_k_m/load',{});assert.equal(legacy.status,200,JSON.stringify(legacy.body));\n  assert.equal((await call('/v1/models')).body.data.length,1);assert.equal((await call('/api/runtime')).body.instances[0].variantId,'qwen36-q4_k_m');\n\n }finally{host.kill('SIGTERM');await new Promise(r=>host.once('exit',r));await rm(home,{recursive:true,force:true});}\n});\n"
    },
