      "content": "import test from 'node:test';\r\nimport assert from 'node:assert/strict';\r\nimport {reserve} from './allocate.ts';\r\nconst s=(sku:string,units:number)=>({sku,units});const r=(id:string,sku='a',quantity=1)=>({id,sku,quantity});\r\ntest('empty',()=>assert.deepEqual(reserve([],[]),{accepted:[],rejected:[],remaining:{}}));\r\ntest('exact stock',()=>assert.deepEqual(reserve([s('a',2)],[r('x','a',2)]),{accepted:['x'],rejected:[],remaining:{a:0}}));\r\ntest('duplicates stock added',()=>assert.equal(reserve([s('a',2),s('a',3)],[r('x','a',4)]).remaining.a,1));\r\ntest('trim stock and requests',()=>assert.deepEqual(reserve([s(' a ',2)],[r(' x ',' a ',1)]),{accepted:['x'],rejected:[],remaining:{a:1}}));\r\ntest('trim duplicate stock',()=>assert.equal(reserve([s(' a ',1),s('a',2)],[]).remaining.a,3));\r\ntest('unknown sku',()=>assert.deepEqual(reserve([s('a',1)],[r('x','z')]),{accepted:[],rejected:[{id:'x',reason:'unknown-sku'}],remaining:{a:1}}));\r\ntest('insufficient consumes nothing',()=>assert.deepEqual(reserve([s('a',2)],[r('x','a',3),r('y','a',2)]),{accepted:['y'],rejected:[{id:'x',reason:'insufficient-stock'}],remaining:{a:0}}));\r\ntest('first duplicate request wins',()=>assert.deepEqual(reserve([s('a',4)],[r('x','a',2),r('x','a',1)]),{accepted:['x'],rejected:[],remaining:{a:2}}));\r\ntest('trim request IDs before dedup',()=>assert.equal(reserve([s('a',4)],[r(' x '),r('x')]).remaining.a,3));\r\ntest('rejected first duplicate still wins',()=>assert.deepEqual(reserve([s('a',2)],[r('x','z'),r('x','a')]).accepted,[]));\r\ntest('case sensitive SKUs',()=>assert.equal(reserve([s('a',2),s('A',3)],[r('x','A',2)]).remaining.A,1));\r\ntest('sorted remaining keys',()=>assert.deepEqual(Object.keys(reserve([s('z',1),s('A',0),s('b',2)],[]).remaining),['A','b','z']));\r\ntest('preserve order',()=>assert.deepEqual(reserve([s('a',1),s('b',1)],[r('z','b'),r('x','a'),r('a','b'),r('b','z')]),{accepted:['z','x'],rejected:[{id:'a',reason:'insufficient-stock'},{id:'b',reason:'unknown-sku'}],remaining:{a:0,b:0}}));\r\ntest('zero stock retained',()=>assert.deepEqual(reserve([s('a',0)],[]).remaining,{a:0}));\r\ntest('frozen inputs',()=>{const a=Object.freeze([Object.freeze(s(' a ',2))]);const b=Object.freeze([Object.freeze(r(' x ','a'))]);assert.equal(reserve(a as any,b as any).remaining.a,1);});\r\ntest('inputs unchanged',()=>{const a=[s(' a ',2)];const b=[r(' x ',' a ')];const old=structuredClone([a,b]);reserve(a,b);assert.deepEqual([a,b],old);});\r\nfor(const x of [s('',1),s(' ',1),s('a',-1),s('a',1.5),s('a',NaN),s('a',Infinity)])test('invalid stock '+JSON.stringify(x),()=>assert.throws(()=>reserve([x],[]),RangeError));\r\nfor(const x of [r(''),r(' '),r('x',''),r('x',' '),r('x','a',0),r('x','a',-1),r('x','a',1.5),r('x','a',NaN),r('x','a',Infinity)])test('invalid request '+JSON.stringify(x),()=>assert.throws(()=>reserve([s('a',3)],[x]),RangeError));\r\ntest('invalid duplicate rejected',()=>assert.throws(()=>reserve([s('a',3)],[r('x'),r('x','a',0)]),RangeError));\r\n"
    },
