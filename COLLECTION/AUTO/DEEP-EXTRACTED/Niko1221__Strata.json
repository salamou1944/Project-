      "path": "app/host/server/agent/gateway-client.mjs",
      "sha": "9d0db7caa3ba417eb80a5818e78dc8e21f45f687",
      "bucket": "contract",
      "source_content_sha256": "2adf45671b888918e13190b39dd5547ffc004ec021b6c3862840f517769f85b4",
      "content_sha256": "a9d230eafb711e4840095c7983df67ddd08e0bf82d50d2a619bf3eeb04c94427",
      "redaction_applied": true,
      "redaction_reasons": [
