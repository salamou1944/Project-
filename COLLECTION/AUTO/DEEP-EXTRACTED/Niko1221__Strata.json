      "path": "docs/benchmarks/windows-zen2-gfx1030-workers.md",
      "sha": "fc6e8f272acc6e4f053a60044696601e854b29dc",
      "bucket": "runtime",
      "source_content_sha256": "284e874551faf4d5ec2d90eda0fca8f659655369337617dec3810f2aed9a0bb3",
      "content_sha256": "284e874551faf4d5ec2d90eda0fca8f659655369337617dec3810f2aed9a0bb3",
