      "content": "{\"target_tokens\": 4096, \"prompt_tokens_tokenized\": 3845, \"run\": 1, \"nonce\": \"c5e721545f8023214812244dc400fff3\", \"ttft_s\": 20.072, \"total_s\": 28.842, \"first_to_last_s\": 8.77, \"usage\": {\"prompt_tokens\": 4441, \"completion_tokens\": 256, \"total_tokens\": 4697, \"prompt_tokens_details\": {\"cached_tokens\": 0}}, \"content_chars\": 1287, \"reasoning_chars\": 0, \"content_head\": \"Strata is a local inference engine designed to run large Mixture-of-Experts (MoE) models, specifically the Qwen3.8-Flash-Next family, on consumer hardware equipped with a single NVIDIA or AMD graphics\"}\n{\"target_tokens\": 4096, \"prompt_tokens_tokenized\": 3845, \"run\": 2, \"nonce\": \"da7d9ae7c48b8080545d4e571d7fe826\", \"ttft_s\": 18.626, \"total_s\": 27.896, \"first_to_last_s\": 9.27, \"usage\": {\"prompt_tokens\": 4441, \"completion_tokens\": 256, \"total_tokens\": 4697, \"prompt_tokens_details\": {\"cached_tokens\": 0}}, \"content_chars\": 1267, \"reasoning_chars\": 0, \"content_head\": \"Strata is a local inference engine that runs the large Qwen3.8-Flash-Next mixture-of-experts (MoE) model on consumer hardware, specifically targeting a single NVIDIA or AMD GPU paired with system RAM.\"}\n{\"target_tokens\": 4096, \"prompt_tokens_tokenized\": 3845, \"run\": 3, \"nonce\": \"69dfdfb2070a585530e72542c7cb7fb1\", \"ttft_s\": 18.519, \"total_s\": 27.196, \"first_to_last_s\": 8.673, \"usage\": {\"prompt_tokens\": 4441, \"completion_tokens\": 256, \"total_tokens\": 4697, \"prompt_tokens_details\": {\"cached_tokens\": 0}}, \"content_chars\": 1249, \"reasoning_chars\": 0, \"content_head\": \"Strata is a local inference engine that runs the Qwen3.8-Flash-Next mixture-of-experts (MoE) model on consumer hardware, specifically targeting a single NVIDIA or AMD GPU paired with system RAM. It se\"}\n{\"target_tokens\": 32768, \"prompt_tokens_tokenized\": 32365, \"run\": 1, \"nonce\": \"5323d25c69c0568ac103ac6dfa4c9fbb\", \"ttft_s\": 62.582, \"total_s\": 70.942, \