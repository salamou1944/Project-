      "content": "var express = require(\"express\");\nvar router = express.Router();\n\n/* GET home page. */\nrouter.get(\"/\", function (req, res, next) {\n    res.render(\"index\", { title: \"Express\" });\n});\n\nmodule.exports = router;\n"
