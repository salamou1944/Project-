      "path": "browser/package.json",
      "sha": "83fdc20568efbfa64439f9afd14dcab8efde864c",
      "bucket": "eval",
      "content_sha256": "a5cf7140d1993757e48bc7b562d031350a0856dd6961447bce5a0b421f891f79",
      "content": "{\n  \"name\": \"browser\",\n  \"version\": \"1.0.0\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\",\n    \"start\": \"node api-server.js\"\n  },\n  \"keywords\": [],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"description\": \"\",\n  \"dependencies\": {\n    \"@playwright/test\": \"^1.51.1\",\n    \"axios\": \"^1.8.4\",\n    \"cors\": \"^2.8.5\",\n    \"express\": \"^4.18.3\",\n    \"uuid\": \"^11.1.0\"\n  }\n}\n"
