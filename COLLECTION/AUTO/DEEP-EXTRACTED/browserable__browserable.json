      "content_sha256": "f9b1a6ce681620ebd66ade09f1d4ab241c85008e7fda95351f42f2dbe84932cc",
      "content": "{\n  \"$schema\": \"https://mintlify.com/docs.json\",\n  \"theme\": \"mint\",\n  \"name\": \"Browserable\",\n  \"colors\": {\n    \"primary\": \"#3064E3\",\n    \"light\": \"#3064E3\",\n    \"dark\": \"#3064E3\"\n  },\n  \"favicon\": {\n    \"light\": \"/favicon.ico\",\n    \"dark\": \"/favicon.ico\"\n  },\n  \"navigation\": {\n    \"tabs\": [\n      {\n        \"tab\": \"Documentation\",\n        \"groups\": [\n          {\n            \"group\": \"Getting Started\",\n            \"pages\": [\n              \"getting-started/introduction\",\n              \"quickstart\",\n              \"getting-started/demos\"\n            ]\n          },\n          {\n            \"group\": \"Development\",\n            \"pages\": [\n              \"development/local-development\",\n              \"development/environment-variables\",\n              \"development/roadmap\",\n              \"development/cli\",\n              \"development/troubleshooting\"\n            ]\n          },\n          {\n            \"group\": \"Guides\",\n            \"pages\": [\n              \"guides/custom-functions\",\n              \"guides/self-hosting\"\n            ]\n          },\n          {\n            \"group\": \"Customization\",\n            \"pages\": [\n              \"guides/customization/storage\",\n              \"guides/customization/database\",\n              \"guides/customization/llm\",\n              \"guides/customization/remote-browsers\"\n            ]\n          },\n          {\n            \"group\": \"Admin Interface\",\n            \"pages\": [\n              \"guides/admin/api-keys\",\n              \"guides/admin/task-creation\",\n              \"guides/admin/flow-chart\",\n              \"guides/admin/llm-calls\",\n              \"guides/admin/data-table\"\n            ]\n          }\n        ]\n      },\n      {\n        \"tab\": \"REST API\",\n        \"groups\": [\n          {\n            \"group\": \"API Documentation\",\n            \"pages\": [\n              \"rest-api/introduction\"\n            ]\n          },\n          {\n            \"group\": \"System Endpoints\",\n            \"pages\": [\n              \"rest-api/endpoint/health\",\n              \"rest-api/endpoint/check\"\n            ]\n          },\n          {\n            \"group\": \"Task Management\",\n            \"pages\": [\n              \"rest-api/endpoint/list-tasks\",\n              \"rest-api/endpoint/create-task\",\n              \"rest-api/endpoint/task-stop\"\n            ]\n          },\n          {\n            \"group\": \"Run Management\",\n            \"pages\": [\n              \"rest-api/endpoint/task-runs\",\n              \"rest-api/endpoint/task-run-status\",\n              \"rest-api/endpoint/task-run-result\",\n              \"rest-api/endpoint/task-run-stop\",\n              \"rest-api/endpoint/task-run-gif\"\n            ]\n          }\n        ]\n      },\n      {\n        \"tab\": \"JS SDK\",\n        \"groups\": [\n          {\n            \"group\": \"JS SDK\",\n            \"pages\": [\n              \"js-sdk/introduction\",\n              \"js-sdk/authentication\",\n              \"js-sdk/tasks\",\n              \"js-sdk/api-reference\"\n            ]\n          }\n        ]\n      },\n      {\n        \"tab\": \"Cloud\",\n        \"groups\": [\n          {\n            \"group\": \"Cloud\",\n            \"pages\": [\n              \"cloud/introduction\"\n            ]\n          }\n        ]\n      }\n    ],\n    \"global\": {\n      \"anchors\": [\n        {\n          \"anchor\": \"Join Discord\",\n          \"href\": \"https://discord.gg/b6s9fXNjeQ\",\n          \"icon\": \"discord\",\n          \"primary\": true\n        },\n        {\n          \"anchor\": \"GitHub\",\n          \"href\": \"https://github.com/browserable/browserable\",\n          \"icon\": \"github\"\n        },\n        {\n          \"anchor\": \"X/ Twitter\",\n          \"href\": \"https://x.com/browserable\",\n          \"icon\": \"twitter\"\n        },\n        {\n          \"anchor\": \"Blog\",\n          \"href\": \"https://browserable.ai/blog\",\n          \"icon\": \"newspaper\"\n        },\n        {\n          \"anchor\": \"Roadmap\",\n          \"href\": \"https://www.browserable.ai/roadmap\", \n          \"icon\": \"map\"\n        }\n      ]\n    }\n  },\n  \"logo\": {\n    \"light\": \"/browserable-ai.png\",\n    \"dark\": \"/browserable-ai-invert.png\"\n  },\n  \"navbar\": {\n    \"links\": [\n      {\n        \"label\": \"Discord\",\n        \"href\": \"https://discord.gg/b6s9fXNjeQ\"\n      },\n      {\n        \"label\": \"Twitter\",\n        \"href\": \"https://x.com/browserable\"\n      },\n      {\n        \"label\": \"Support\",\n        \"href\": \"mailto:sid@browserable.ai\"\n      }\n    ],\n    \"primary\": {\n      \"type\": \"button\",\n      \"label\": \"Github Repo\",\n      \"href\": \"https://github.com/browserable/browserable\"\n    }\n  },\n  \"footer\": {\n    \"socials\": {\n      \"x\": \"https://x.com/browserable\",\n      \"github\": \"https://github.com/browserable/browserable\",\n      \"discord\": \"https://discord.gg/b6s9fXNjeQ\"\n    }\n  }\n}"
