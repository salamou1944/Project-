      "content": "{\n  \"name\": \"js-sdk-test\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Test project for Browserable JS SDK\",\n  \"main\": \"index.js\",\n  \"scripts\": {\n    \"test\": \"node index.js\"\n  },\n  \"keywords\": [\n    \"browserable\",\n    \"sdk\",\n    \"test\"\n  ],\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"dependencies\": {\n    \"axios\": \"^1.6.7\",\n    \"browserable-js\": \"^1.0.1\"\n  }\n}\n"
