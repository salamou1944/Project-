      "content": "{\n  \"name\": \"nodeserver\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Basic express-node server\",\n  \"main\": \"server.js\",\n  \"scripts\": {\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\"\n  },\n  \"author\": \"\",\n  \"license\": \"ISC\",\n  \"dependencies\": {\n    \"body-parser\": \"^1.19.0\",\n    \"express\": \"^4.17.1\"\n  }\n}\n"
