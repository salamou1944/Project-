      "path": "test/sql/excel/test_excel_numformat_long_format.test",
      "sha": null,
      "content_sha256": "27dc679667e01cdf5cfcc3d704d7f5993ed4737b0fc570c1326c387fd8a5fbdb",
      "score": 54,
      "content": "# name: test/sql/excel/test_excel_numformat_long_format.test\n# description: Number formats that exceed the format scanner's symbol limit must fail cleanly\n# group: [excel]\n\nrequire excel\n\n# inserting grouping separators used to write past the end of the symbol array\nquery I\nSELECT text(1234567.897, '$#,##0' || repeat('9', 70));\n----\n(empty)\n\n# 70 extra digits plus their separators fit exactly within the symbol limit\nquery I\nSELECT text(1234567.897, '#,##0' || repeat('0', 70));\n----\n00,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,000,001,234,568\n\n# one more digit exceeds the limit\nquery I\nSELECT text(1234567.897, '#,##0' || repeat('0', 71));\n----\n(empty)\n\nquery I\nSELECT text(1234567.897, '#,##0' || repeat('0', 500));\n----\n(empty)\n"
    },
    {
      "path": "test/sql/excel/test_excel_numformat_currency_text.test",
      "sha": null,
      "content_sha256": "ccad8f4e419225a1b3fef2f57d2a7b7a0569d0d1ad46f8602e88eb4009112846",
      "score": 54,
      "content": "# name: test/sql/excel/test_excel_numformat_currency_text.test\n# description: A currency symbol without digit placeholders is literal text, like any other symbol\n# group: [excel]\n\nrequire excel\n\nquery I\nSELECT text(1234.567, '$');\n----\n$\n\nquery I\nSELECT text(1234.567, '€');\n----\n€\n\nquery I\nSELECT text(1234.567, '\"$\"');\n----\n$\n\nquery I\nSELECT text(1234.567, '$-');\n----\n$-\n\n# digit placeholders still make it a currency format\nquery I\nSELECT text(1234.567, '$#');\n----\n$1235\n\nquery I\nSELECT text(1234.567, '$#,##0.00');\n----\n$1,234.57\n\nquery I\nSELECT text(-1234.567, '$#,##0.00');\n----\n-$1,234.57\n\nquery I\nSELECT text(1234.567, '$0,00');\n----\n$1,235\n"
    },
