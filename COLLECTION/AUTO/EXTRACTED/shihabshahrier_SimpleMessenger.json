      "content": "version: \"3.7\"\n\nservices:\n\n  postgres:\n    image: postgres:12\n    container_name: postgres\n    environment:\n      POSTGRES_USER: postgres\n      POSTGRES_PASSWORD: postgres\n      POSTGRES_DB: postgres\n    ports:\n      - \"5432:5432\"\n  redis:\n    image: redis:5\n    container_name: redis\n    ports:\n      - \"6379:6379\""
