      "content_sha256": "9a0fa055f70695c38d10bf76ed2e15122c6bb97de69ef9a247f01749b3d2adf1",
      "score": 117,
      "content": "#!/usr/bin/env bash\ngit clone https://github.com/gepa-ai/dspy.git ./gepa_artifact/utils/dspy && cd ./gepa_artifact/utils/dspy && git checkout gepa_study && cd ../../../\ngit clone https://github.com/Ziems/arbor.git ./gepa_artifact/utils/arbor && cd ./gepa_artifact/utils/arbor && git checkout gepa_study && cd ../../../\n"
