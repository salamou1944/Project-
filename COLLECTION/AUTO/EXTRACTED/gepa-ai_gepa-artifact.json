      "content": "[project]\nname = \"gepa_artifact\"\nversion = \"0.0.1\"\ndescription = \"GEPA is a novel prompt optimizers that uses text feedback to improve compound AI systems.\"\nauthors = [\n  { name = \"Lakshya A Agrawal\", email = \"lakshyaaagrawal@berkeley.edu\" }\n]\nlicense = { text = \"MIT\" }\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\ndependencies = [\n    \"bm25s==0.2.12\",\n    \"dspy\",\n    \"fasteners==0.19\",\n    \"func-timeout==4.3.5\",\n    \"jax[cpu]==0.6.0\",\n    \"matplotlib>=3.10.3\",\n    \"pystemmer==2.2.0.3\",\n    \"python-dotenv>=1.1.0\",\n    \"ruff>=0.11.13\",\n    \"tabulate>=0.9.0\",\n    \"pylcs==0.1.1\",\n    \"seaborn\",\n    \"adjustText\",\n\n    \"diskcache\",\n    \"evaluate==0.4.3\",\n    \"fqdn==1.5.1\",\n    \"httptools==0.6.4\",\n    \"isoduration==20.11.0\",\n    \"jupyter==1.1.1\",\n    \"langchain-chroma==0.2.3\",\n    \"langchain-community==0.3.23\",\n    \"langchain-huggingface==0.1.2\",\n    \"psutil==7.0.0\",\n    \"sacrebleu==2.5.1\",\n    \"tinycss2==1.4.0\",\n    \"uri-template==1.3.0\",\n    \"uvloop==0.21.0\",\n    \"wandb==0.19.10\",\n    \"watchfiles==1.0.5\",\n    \"webcolors==24.11.1\",\n    \"websockets==15.0.1\",\n    \"absl-py\",\n    \"langdetect\",\n    \"nltk\",\n    \"immutabledict\",\n    \"spacy\",\n    \"emoji\",\n    \"syllapy\",\n    \"unicodedata2\",\n    \"pip\",\n    \"math-verify==0.6.0\",\n    \"lark\",\n    \"sympy\",\n    \"levenshtein\",\n\n    \"arbor-ai\",\n    \"flash-attn>=2.7.4.post1\",\n    \"nvitop>=1.5.1\",\n    \"grpcio\",\n    \"grpcio-tools\",\n    \"nvitop\"\n]\n\n[tool.uv.sources]\narbor-ai = { path = \"gepa_artifact/utils/arbor\", editable = true }\ndspy = { path = \"gepa_artifact/utils/dspy\", editable = true }\n\n[tool.uv]\nno-build-isolation-package = [\"flash-attn\"]\n\n[[tool.uv.dependency-metadata]]\nname = \"flash-attn\"\nversion = \"2.7.4.post1\"\nrequires-dist = [\"torch\", \"setuptools\"]\n"
