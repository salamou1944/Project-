": 27,\n\t\t\"AL\": 28,\n\t\t\"EE\": 20,\n\t\t\"AO\": 25,\n\t\t\"GE\": 22,\n\t\t\"BR\": 29,\n\t\t\"GA\": 27,\n\t\t\"GB\": 22,\n\t\t\"TN\": 24,\n\t\t\"TR\": 26,\n\t\t\"NO\": 15,\n\t\t\"BF\": 27,\n\t\t\"FR\": 27,\n\t\t\"BG\": 22,\n\t\t\"BH\": 22,\n\t\t\"BI\": 16,\n\t\t\"FO\": 18,\n\t\t\"BE\": 16,\n\t\t\"BJ\": 28,\n\t\t\"FI\": 18,\n\t\t\"CZ\": 24,\n\t\t\"CY\": 28,\n\t\t\"SE\": 24,\n\t\t\"CV\": 25,\n\t\t\"SI\": 19,\n\t\t\"KW\": 30,\n\t\t\"SK\": 24,\n\t\t\"SN\": 28,\n\t\t\"KZ\": 20,\n\t\t\"SM\": 27,\n\t\t\"CI\": 28,\n\t\t\"PL\": 28,\n\t\t\"RS\": 22,\n\t\t\"GT\": 28,\n\t\t\"CG\": 27,\n\t\t\"LB\": 28,\n\t\t\"CH\": 21,\n\t\t\"GR\": 27,\n\t\t\"PK\": 24,\n\t\t\"LI\": 21,\n\t\t\"CR\": 22,\n\t\t\"GL\": 18,\n\t\t\"CM\": 27,\n\t\t\"GI\": 23,\n\t\t\"SA\": 24,\n\t}\n)\n\n/*\n\tReturns the allowed length of an IBAN code for a certain country.\n\t\t\tor -1 if the country code could not be looked up.\n*/\nfunc getAllowedLength(countryCode string) int {\n\tvar length int\n\tvar ok bool\n\n\tlength, ok = COUNTRY_CODE_TO_LENGTH_MAP[countryCode]\n\tif ok {\n\t\treturn length\n\t} else {\n\t\treturn -1\n\t}\n}\n"
    },
