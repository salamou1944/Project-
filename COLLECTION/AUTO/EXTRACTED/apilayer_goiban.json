       \"MU\",\n\t\t\"Moldova\":                   \"MD\",\n\t\t\"Monaco\":                    \"MC\",\n\t\t\"Montenegro\":                \"ME\",\n\t\t\"Mozambique\":                \"MZ\",\n\t\t\"Netherlands\":               \"NL\",\n\t\t\"New Caledonia\":             \"FR\",\n\t\t\"Norway\":                    \"NO\",\n\t\t\"Pakistan\":                  \"PK\",\n\t\t\"Palestine, State of\":       \"PS\",\n\t\t\"Poland\":                    \"PL\",\n\t\t\"Portugal\":                  \"PT\",\n\t\t\"Romania\":                   \"RO\",\n\t\t\"Réunion\":                   \"FR\",\n\t\t\"Saint-Pierre and Miquelon\": \"FR\",\n\t\t\"San Marino\":                \"SM\",\n\t\t\"Sao Tome and Principe\":     \"PT\",\n\t\t\"Saudi Arabia\":              \"SA\",\n\t\t\"Senegal\":                   \"SN\",\n\t\t\"Serbia\":                    \"RS\",\n\t\t\"Slovakia\":                  \"SK\",\n\t\t\"Slovenia\":                  \"SI\",\n\t\t\"Spain\":                     \"ES\",\n\t\t\"Sweden\":                    \"SE\",\n\t\t\"Switzerland\":               \"CH\",\n\t\t\"Tunisia\":                   \"TN\",\n\t\t\"Turkey\":                    \"TR\",\n\t\t\"Ukraine\":                   \"UA\",\n\t\t\"United Arab Emirates\":      \"AE\",\n\t\t\"United Kingdom\":            \"GB\",\n\t\t\"Wallis and Futuna\":         \"FR\",\n\t}\n)\n\n/*\n\tReturns the 2-digit country code for a country name.\n\tor an empty string if the country code could not be looked up.\n*/\nfunc getCountryCode(countryName string) string {\n\tvar countryCode string\n\tvar ok bool\n\n\tcountryCode, ok = COUNTRY_TO_CC_MAP[countryName]\n\tif ok {\n\t\treturn countryCode\n\t}\n\n\treturn \"\"\n}\n"
