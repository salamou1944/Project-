      "content": "/**\n * @solvo/token-burn-mcp\n * MCP server that proxies user-pasted Anthropic API key to real token usage.\n * Uses stdio transport for Claude Code Desktop integration.\n */\nconst { Server } = require('@modelcontextprotocol/sdk/server/index.js');\nconst { StdioServerTransport } = require('@modelcontextprotocol/sdk/server/stdio.js');\nconst {\n  CallToolRequestSchema,\n  ListToolsRequestSchema,\n} = require('@modelcontextprotocol/sdk/types.js');\nconst https = require('https');\n\nconst ANTHROPIC_BASE_URL = 'https://api.anthropic.com';\n\n/**\n * Make an HTTPS request to the Anthropic API.\n */\nfunction httpsRequest(url, options = {}) {\n  return new Promise((resolve, reject) => {\n    const urlObj = new URL(url);\n    const reqOptions = {\n      hostname: urlObj.hostname,\n      port: urlObj.port || 443,\n      path: urlObj.pathname + urlObj.search,\n      method: options.method || 'GET',\n      headers: options.headers || {},\n    };\n\n    const req = https.request(reqOptions, (res) => {\n      let data = '';\n      res.on('data', (chunk) => (data += chunk));\n      res.on('end', () => {\n        try {\n          resolve({ status: res.statusCode, data: JSON.parse(data), headers: res.headers });\n        } catch {\n          resolve({ status: res.statusCode, data, headers: res.headers });\n        }\n      });\n    });\n\n    req.on('error', reject);\n    req.setTimeout(30000, () => {\n      req.destroy();\n      reject(new Error('Request timeout'));\n    });\n\n    if (options.body) {\n      req.write(typeof options.body === 'string' ? options.body : JSON.stringify(options.body));\n    }\n    req.end();\n  });\n}\n\n/**\n * Get real token usage from Anthropic API using the user's API key.\n */\nasync function getRealUsage(apiKey) {\n  const body = JSON.stringify({\n    model: 'claude-sonnet-4-6-20250514',\n    max_tokens: 1,\n    messages: [{ role: 'user', content: 'ping' }],\n  });\n\n  const result = await httpsRequest(`${ANTHROPIC_BASE_URL}/v1/messages`, {\n    method: 'POST',\n    headers: {\n      'x-api-key': apiKey,\n      'anthropic-version': '2023-06-01',\n      'content-type': 'application/json',\n      'anthropic-dangerous-direct-browser-access': 'true',\n    },\n    body,\n  });\n\n  if (result.status !== 200) {\n    return null;\n  }\n\n  const data = result.data;\n  const usage = data?.usage;\n\n  if (!usage) return null;\n\n  const inputTokens = usage.input_tokens || 0;\n  const outputTokens = usage.output_tokens || 0;\n  const totalTokens = inputTokens + outputTokens;\n\n  return {\n    inputTokens,\n    outputTokens,\n    totalTokens,\n    sampleAccepted: data?.content?.[0]?.type === 'text',\n    rateLimitRemaining: result.headers['x-ratelimitremaining'] || null,\n  };\n}\n\n/**\n * Create the MCP server.\n */\nconst server = new Server(\n  {\n    name: '@solvo/token-burn-mcp',\n    version: '0.1.0',\n  },\n  {\n    capabilities: {\n      tools: {},\n    },\n  }\n);\n\n/**\n * Declare the get_token_burn tool.\n */\nserver.setRequestHandler(ListToolsRequestSchema, async () => {\n  return {\n    tools: [\n      {\n        name: 'get_token_burn',\n        description:\n          'Get real token burn data for a Claude API key. Returns input_tokens, output_tokens, total_tokens, and estimated_burn_rate from a live API call. Use this when a user pastes their Anthropic API key and wants to see real token usage.',\n        inputSchema: {\n          type: 'object',\n          properties: {\n            api_key: {\n              type: 'string',\n              description: 'The user\\'s Anthropic API key (sk-ant-...). The key is only used for this single request and is never stored.',\n            },\n          },\n          required: ['api_key'],\n        },\n      },\n    ],\n  };\n});\n\n/**\n * Handle get_token_burn tool calls.\n */\nserver.setRequestHandler(CallToolRequestSchema, async (request) => {\n  const { name, arguments: args } = request.params;\n\n  if (name !== 'get_token_burn') {\n    return {\n      content: [{ type: 'text', text: `Unknown tool: ${name}` }],\n      isError: true,\n    };\n  }\n\n  const apiKey = [REDACTED];\n\n  if (!apiKey || typeof apiKey !== 'string' || !apiKey.startsWith('sk-')) {\n    return {\n      content: [\n        {\n          type: 'text',\n          text: 'Error: Invalid API key. Please provide a valid Anthropic API key starting with \"sk-\".',\n        },\n      ],\n      isError: true,\n    };\n  }\n\n  try {\n    const usage = await getRealUsage(apiKey);\n\n    if (!usage) {\n      return {\n        content: [\n          {\n            type: 'text',\n            text: 'Error: Could not retrieve token data. The API key may be invalid or the API request failed.',\n          },\n        ],\n        isError: true,\n      };\n    }\n\n    // Estimate burn rate: Claude Code sessions are typically input-heavy (60-70% input)\n    const estimatedBurnRate = (usage.totalTokens * 0.7).toFixed(1);\n\n    return {\n      content: [\n        {\n          type: 'text',\n          text: JSON.stringify(\n            {\n              authenticated: true,\n              input_tokens: usage.inputTokens,\n              output_tokens: usage.outputTokens,\n              total_tokens: usage.totalTokens,\n              rate_limit_remaining: usage.rateLimitRemaining,\n              estimated_burn_rate: `${estimatedBurnRate} tokens/min`,\n              quota_warning: false,\n            },\n            null,\n            2\n          ),\n        },\n      ],\n    };\n  } catch (error) {\n    return {\n      content: [\n        {\n          type: 'text',\n          text: `Error: ${error.message || 'Unknown error occurred while fetching token data.'}`,\n        },\n      ],\n      isError: true,\n    };\n  }\n});\n\n/**\n * Start the MCP server with stdio transport.\n */\nasync function main() {\n  const transport = new StdioServerTransport();\n  await server.connect(transport);\n  // Keep process alive — stdio transport manages its own stdin/stdout loop\n}\n\nmain().catch((err) => {\n  console.error('Failed to start token-burn MCP server:', err);\n  process.exit(1);\n});",
