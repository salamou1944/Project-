    {
      "path": "tests/setkey2esp-secrets.pl",
      "sha": "92fa3856be83f71fda377efd2096d2f54c0af728",
      "content_sha256": "4672c66d39260ebe55e6dd679f36c15d7bc9e00e8e6a3536f0827b23cfbffd3b",
      "score": 138,
      "content": "#!/usr/local/bin/perl\n#\n# usage:\n#\tsetkey -D | perl thisfile > secrets.txt\n#\ttcpdump -n -E \"file secrets.txt\"\n#\nwhile (<>) {\n\tif (/^(\\S+)\\s+(\\S+)/) {\n\t\t$src = $1;\n\t\t$dst = $2;\n\t\tnext;\n\t}\n\tif (/^\\s+esp.*spi=(\\d+)/) {\n\t\t$spi = $1;\n\t\tnext;\n\t}\n\tif (/^\\s+E:\\s+(\\S+)\\s+(.*)$/) {\n\t\t$algo = $1. \"-hmac96\";\n\t\t($secret = $2) =~ s/\\s+//g;\n\n\t\tprintf\"0x%x@%s %s:0x%s\\n\", $spi, $dst, $algo, $secret;\n\t\tnext;\n\t}\n}\n"
    },
