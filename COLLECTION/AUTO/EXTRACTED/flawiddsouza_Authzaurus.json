      "path": "package.json",
      "sha": null,
      "content_sha256": "aa00011b24ef087377e92bef00b0055d1ce16b08ca307539139abc5c09ffa89e",
      "score": 120,
      "content": "{\n    \"private\": true,\n    \"dependencies\": {\n        \"better-sqlite3\": \"^13.0.3\",\n        \"express\": \"^4.17.1\",\n        \"express-session\": \"^1.17.1\"\n    }\n}\n"
    },
    {
      "path": "app.js",
      "sha": null,
      "content_sha256": "a1de7236880e2b7a9df6bd2c4d1b7a79498874516055c589716c8e2244811aba",
      "score": 35,
      "content": "const path = require('path')\nconst express = require('express')\nconst http = require('http')\nconst fs = require('fs')\nconst { createSession } = require('./session-store')\n\nfunction getAbsolutePath(pathToFile) {\n    return path.join(__dirname, pathToFile)\n}\n\nconst app = express()\nconst server = http.createServer(app)\n\napp.use(express.urlencoded({ extended: true }))\n\napp.use(createSession(getAbsolutePath('session-data')).middleware)\n\nvar isAuthenticated = (req, res, next) => {\n    if(req.session.authenticated) {\n        next()\n    } else {\n        res.sendFile(getAbsolutePath('login.html'))\n    }\n}\n\napp.post('/', (req, res) => {\n    const credentials = JSON.parse(fs.readFileSync(getAbsolutePath('credentials.json'), 'utf8'))\n    if(req.body.username === credentials.username && req.body.password === credentials.password) {\n        req.session.authenticated = true\n    }\n\n    res.redirect(req.body.redirectBackTo)\n})\n\nlet availableApps = fs.readdirSync(getAbsolutePath('/apps')).filter(item => item !== '.gitignore')\n\napp.get('/', isAuthenticated, (req, res) => {\n    res.send(`\n        <!DOCTYPE html>\n        <html>\n            <head>\n                <meta charset=\"utf-8\">\n                <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n                <title>Authzaurus - Home</title>\n                <style>\n                ul {\n                    padding-left: 2em;\n                }\n\n                ul li {\n                    margin-top: 0.5em;\n                }\n                </style>\n            <body>\n                You are logged in<br>\n\n                <ul>\n                    ${\n                        availableApps.map(availableApp => {\n                            return `<li><a href=\"apps/${availableApp}\">${availableApp}</a></li>`\n                        }).join('\\n')\n                    }\n                <ul>\n            </body>\n        </html>\n    `)\n})\n\napp.get('/logout', isAuthenticated, (req, res) => {\n    // Deleted from the store too, so the cookie stops working anywhere it was copied.\n    req.session.destroy(() => {\n        res.clearCookie('my_session')\n        res.redirect('/')\n    })\n})\n\n\navailableApps.forEach(availableApp => {\n    if(fs.existsSync(getAbsolutePath(`apps/${availableApp}/app.js`))) {\n        try {\n            app.use(`/apps/${availableApp}`, isAuthenticated, require(`./apps/${availableApp}/app.js`)(server))\n        } catch {\n            app.use(`/apps/${availableApp}`, isAuthenticated, require(`./apps/${availableApp}/app.js`))\n        }\n    } else {\n        app.use(`/apps/${availableApp}`, isAuthenticated, express.static(getAbsolutePath(`apps/${availableApp}/public`)))\n    }\n})\n\nserver.listen(9901)\n"
    },
