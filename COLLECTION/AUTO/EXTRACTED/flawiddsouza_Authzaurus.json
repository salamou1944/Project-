      "content": "const fs = require('fs')\nconst path = require('path')\nconst { randomBytes } = require('crypto')\nconst Database = require('better-sqlite3')\nconst session = require('express-session')\n\n// A session unused this long is dropped, and its cookie expires with it, so\n// closing the browser keeps you signed in.\nconst IDLE_TTL = 30 * 24 * 60 * 60 * 1000\n\n// Made once, on the first start, so restarts keep signing with the same one.\nfunction readSecret(dir) {\n    const secretPath = path.join(dir, 'secret')\n    try {\n        fs.writeFileSync(secretPath, randomBytes(32).toString('hex'), { mode: 0o600, flag: 'wx' })\n    } catch (err) {\n        if (err.code !== 'EEXIST') throw err\n    }\n    const secret = [REDACTED], 'utf8').trim()\n    // An empty or cut-short file would sign every cookie with a guessable key.\n    if (secret.length < 32) throw new Error(`${secretPath} is too short. Delete it and restart to make a new one.`)\n    return secret\n}\n\n/**\n * The login session middleware. Sessions are kept in SQLite under `dir`, so\n * signing in survives a restart or deploy, beside the secret that signs their\n * cookies.\n */\nfunction createSession(dir) {\n    fs.mkdirSync(dir, { recursive: true })\n    const secret = [REDACTED]\n    const db = new Database(path.join(dir, 'sessions.db'))\n    db.exec(`\n        CREATE TABLE IF NOT EXISTS sessions (\n            sid TEXT PRIMARY KEY,\n            data TEXT NOT NULL,\n            expires_at INTEGER NOT NULL\n        );\n        CREATE INDEX IF NOT EXISTS idx_sessions_expires_at ON sessions(expires_at);\n    `)\n    const getRow = db.prepare('SELECT data FROM sessions WHERE sid = ? AND expires_at > ?')\n    const upsert = db.prepare(`\n        INSERT INTO sessions(sid, data, expires_at) VALUES(?, ?, ?)\n        ON CONFLICT(sid) DO UPDATE SET data = excluded.data, expires_at = excluded.expires_at\n    `)\n    const extend = db.prepare('UPDATE sessions SET expires_at = ? WHERE sid = ?')\n    const remove = db.prepare('DELETE FROM sessions WHERE sid = ?')\n    const prune = db.prepare('DELETE FROM sessions WHERE expires_at <= ?')\n\n    const expiresAt = (sess) => {\n        const idle = Date.now() + IDLE_TTL\n        const cookie = sess.cookie?.expires ? new Date(sess.cookie.expires).getTime() : Infinity\n        return Math.min(idle, cookie)\n    }\n\n    const call = (cb, fn) => {\n        let result\n        try {\n            result = fn()\n        } catch (err) {\n            return cb?.(err)\n        }\n        cb?.(null, result)\n    }\n\n    class SqliteStore extends session.Store {\n        get(sid, cb) {\n            call(cb, () => {\n                const row = getRow.get(sid, Date.now())\n                return row ? JSON.parse(row.data) : null\n            })\n        }\n\n        set(sid, sess, cb) {\n            call(cb, () => {\n                prune.run(Date.now())\n                upsert.run(sid, JSON.stringify(sess), expiresAt(sess))\n            })\n        }\n\n        touch(sid, sess, cb) {\n            call(cb, () => { extend.run(expiresAt(sess), sid) })\n        }\n\n        destroy(sid, cb) {\n            call(cb, () => { remove.run(sid) })\n        }\n    }\n\n    const middleware = session({\n        key: 'my_session',\n        secret,\n        store: new SqliteStore(),\n        resave: false,\n        // Each visit pushes the cookie's expiry forward with the session's.\n        rolling: true,\n        cookie: { maxAge: IDLE_TTL },\n        // Only a sign-in or a form that needs one makes a session, so health\n        // checks and signed-out visits add no rows.\n        saveUninitialized: false\n    })\n\n    return { middleware, db }\n}\n\nmodule.exports = { createSession, IDLE_TTL }\n",
