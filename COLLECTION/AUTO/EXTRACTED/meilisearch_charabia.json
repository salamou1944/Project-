      "content": "# Set update schedule for GitHub Actions only\n\nversion: 2\nupdates:\n  - package-ecosystem: \"github-actions\"\n    directory: \"/\"\n    schedule:\n      interval: \"monthly\"\n    labels:\n      - 'skip changelog'\n      - 'dependencies'\n    rebase-strategy: disabled\n"
