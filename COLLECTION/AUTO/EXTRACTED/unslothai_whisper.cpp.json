    },
    {
      "path": ".github/workflows/unsloth-prebuilt-vulkan.yml",
      "sha": null,
      "content_sha256": "e0ef063de33651b3548a2d87f442db4d4eef9f1b392a733eda95410f1ceba283",
      "score": 126,
      "content": "# SPDX-License-Identifier: AGPL-3.0-only\n# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.\n\nname: \"Unsloth whisper prebuilt: Vulkan\"\n\n# Reusable child of unsloth-prebuilt.yml (P1). Vulkan whisper-server bundles for\n# Linux x64 + Windows x64. Dynamic build with GGML_BACKEND_DL so the Vulkan\n# backend is a dlopen'd libggml-vulkan module and the binary still runs on CPU\n# with --no-gpu. The Vulkan loader (libvulkan.so.1 / vulkan-1.dll) is a\n# system/driver library resolved by the OS at runtime, so it is NOT bundled;\n# only ggml's own libggml-vulkan module ships.\n\non:\n  workflow_call:\n    inputs:\n      tag:            { required: true,  type: string }\n      upstream_tag:   { required: true,  type: string }\n      repo:           { required: false, type: string, default: 'unslothai/whisper.cpp' }\n      commit:         { required: true,  type: string }\n      source_artifact: { required: true,  type: string }\n\n    secrets:\n      # Optional so a fork can still run the build; the composite action fails\n      # closed on unslothai itself, where an unsigned publish is the actual\n      # hazard. See .github/actions/sign-windows.\n      AZURE_CLIENT_ID:                     { required: false }\n      AZURE_CLIENT_SECRET:                 { required: false }\n      AZURE_TENANT_ID:                     { required: false }\n      AZURE_TRUSTED_SIGNING_ACCOUNT_NAME:  { required: false }\n      AZURE_CERTIFICATE_PROFILE_NAME:      { required: false }\n\npermissions:\n  contents: read\n\nenv:\n  VULKAN_VERSION: 1.4.313.2\n  WHISPER_MODEL_URL: \"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin\"\n\njobs:\n  build-linux:\n    name: linux/x64\n    runs-on: ubuntu-22.04\n    steps:\n      - name: Checkout build tooling (this repo)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { path: tooling, persist-credentials: false }\n\n      - name: Download stamped source @ ${{ inputs.tag }}\n        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53  # v6.0.0\n        with: { name: \"${{ inputs.source_artifact }}\", path: srcpkg }\n      - name: Extract source\n        run: |\n          set -eux\n          mkdir -p src\n          tar -xzf \"srcpkg/whisper.cpp-source-${{ inputs.tag }}.tar.gz\" -C src --strip-components=1\n\n      - name: Install Vulkan SDK + build dependencies\n        run: |\n          set -eux\n          wget -qO - https://packages.lunarg.com/lunarg-signing-key-pub.asc | sudo apt-key add -\n          sudo wget -qO /etc/apt/sources.list.d/lunarg-vulkan-jammy.list https://packages.lunarg.com/vulkan/lunarg-vulkan-jammy.list\n          sudo apt-get update -y\n          sudo apt-get install -y build-essential mesa-vulkan-drivers vulkan-sdk ninja-build\n\n      - name: ccache\n        uses: hendrikmuhs/ccache-action@5ebbd400eff9e74630f759d94ddd7b6c26299639  # v1.2.20\n        with: { key: vulkan-linux-x64, variant: ccache, evict-old-files: 14d }\n\n      - name: Configure + build (dynamic, backend-DL, CPU fallback)\n        working-directory: src\n        run: |\n          set -eux\n          cmake -S . -B build -G Ninja \\\n            -DCMAKE_BUILD_TYPE=Release \\\n            -DBUILD_SHARED_LIBS=ON \\\n            -DGGML_NATIVE=OFF \\\n            -DGGML_BACKEND_DL=ON \\\n            -DGGML_CPU_ALL_VARIANTS=ON \\\n            -DGGML_VULKAN=ON \\\n            -DWHISPER_BUILD_EXAMPLES=ON \\\n            -DWHISPER_BUILD_SERVER=ON \\\n            -DWHISPER_BUILD_TESTS=OFF \\\n            -DWHISPER_SDL2=OFF \\\n            -DCMAKE_INSTALL_RPATH='$ORIGIN' \\\n            -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \\\n            -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=OFF \\\n            -DCMAKE_C_COMPILER_LAUNCHER=ccache \\\n            -DCMAKE_CXX_COMPILER_LAUNCHER=ccache\n          cmake --build build --config Release --target whisper-server -j \"$(nproc)\"\n          strip build/bin/whisper-server || true\n\n      - name: Package bundle\n        env:\n          OS: linux\n          ARCH: x64\n          ACCEL: vulkan\n          BACKEND: vulkan\n          MIN_OS: \"glibc-2.35\"\n          BIN_DIR: ${{ github.workspace }}/src/build/bin\n          SRC_DIR: ${{ github.workspace }}/src\n          OUT_DIR: ${{ github.workspace }}/dist\n          TAG: ${{ inputs.tag }}\n          UPSTREAM_TAG: ${{ inputs.upstream_tag }}\n          SOURCE_COMMIT: ${{ inputs.commit }}\n          SOURCE_REPO: ${{ inputs.repo }}\n        run: python3 tooling/scripts/package_bundle.py\n\n      # GPU bundles are built and shipped un-run: the Vulkan runner has no GPU,\n      # so there is nothing to validate here, matching unslothai/llama.cpp.\n      - name: Upload bundle artifact\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6.0.0\n        with:\n          name: whisper-${{ inputs.tag }}-linux-x64-vulkan\n          path: dist/whisper-${{ inputs.tag }}-linux-x64-vulkan.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n\n  build-windows:\n    name: windows/x64\n    runs-on: windows-2022\n    # Gate on the environment, matching release-desktop.yml: the job that\n    # can read the signing credentials is named explicitly.\n    environment: release-signing\n    defaults:\n      run: { shell: pwsh }\n    steps:\n      - name: Checkout build tooling (this repo)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { path: tooling, persist-credentials: false }\n\n      - name: Download stamped source @ ${{ inputs.tag }}\n        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53  # v6.0.0\n        with: { name: \"${{ inputs.source_artifact }}\", path: srcpkg }\n      - name: Extract source\n        shell: bash\n        run: |\n          set -eux\n          mkdir -p src\n          tar -xzf \"srcpkg/whisper.cpp-source-${{ inputs.tag }}.tar.gz\" -C src --strip-components=1\n\n      - name: ccache\n        uses: hendrikmuhs/ccache-action@5ebbd400eff9e74630f759d94ddd7b6c26299639  # v1.2.20\n        with: { key: vulkan-windows-x64, variant: ccache, evict-old-files: 14d }\n\n      - name: Install Ninja\n        run: choco install ninja --no-progress\n\n      - name: Setup MSVC\n        uses: ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756  # v1.13.0\n\n      - name: Install Vulkan SDK\n        run: |\n          curl.exe -o $env:RUNNER_TEMP/VulkanSDK-Installer.exe -L \"https://sdk.lunarg.com/sdk/download/${env:VULKAN_VERSION}/windows/vulkansdk-windows-X64-${env:VULKAN_VERSION}.exe\"\n          & \"$env:RUNNER_TEMP\\VulkanSDK-Installer.exe\" --accept-licenses --default-answer --confirm-command install\n          Add-Content $env:GITHUB_ENV \"VULKAN_SDK=C:\\VulkanSDK\\${env:VULKAN_VERSION}\"\n          Add-Content $env:GITHUB_PATH \"C:\\VulkanSDK\\${env:VULKAN_VERSION}\\bin\"\n\n      - name: Configure + build (dynamic, backend-DL, CPU fallback)\n        working-directory: src\n        run: |\n          $env:CMAKE_PREFIX_PATH = $env:VULKAN_SDK\n          cmake -S . -B build -G Ninja `\n            -DCMAKE_BUILD_TYPE=Release `\n            -DBUILD_SHARED_LIBS=ON `\n            -DGGML_NATIVE=OFF `\n            -DGGML_BACKEND_DL=ON `\n            -DGGML_CPU_ALL_VARIANTS=ON `\n            -DGGML_OPENMP=OFF `\n            -DGGML_VULKAN=ON `\n            -DWHISPER_BUILD_EXAMPLES=ON `\n            -DWHISPER_BUILD_SERVER=ON `\n            -DWHISPER_BUILD_TESTS=OFF `\n            -DWHISPER_SDL2=OFF `\n            -DCMAKE_C_COMPILER_LAUNCHER=ccache `\n            -DCMAKE_CXX_COMPILER_LAUNCHER=ccache\n          cmake --build build --config Release --target whisper-server -j 3\n\n      # Before packaging, so every DLL the bundle carries is signed and not\n      # just the server executable. Windows Smart App Control evaluates each\n      # binary as it loads: an unsigned dependent DLL is refused with status\n      # 0xc0e90002 and surfaces as a \"Bad Image\" dialog naming that DLL.\n      - name: Sign Windows binaries\n        uses: ./tooling/.github/actions/sign-windows\n        with:\n          path: src/build/bin\n          azure-client-id: ${{ secrets.AZURE_CLIENT_ID }}\n          azure-client-secret: ${{ secrets.AZURE_CLIENT_SECRET }}\n          azure-tenant-id: ${{ secrets.AZURE_TENANT_ID }}\n          azure-account: ${{ secrets.AZURE_TRUSTED_SIGNING_ACCOUNT_NAME }}\n          azure-certificate-profile: ${{ secrets.AZURE_CERTIFICATE_PROFILE_NAME }}\n\n      - name: Package bundle\n        env:\n          OS: windows\n          ARCH: x64\n          ACCEL: vulkan\n          BACKEND: vulkan\n          MIN_OS: \"windows-10\"\n          BIN_DIR: ${{ github.workspace }}/src/build/bin\n          SRC_DIR: ${{ github.workspace }}/src\n          OUT_DIR: ${{ github.workspace }}/dist\n          TAG: ${{ inputs.tag }}\n          UPSTREAM_TAG: ${{ inputs.upstream_tag }}\n          SOURCE_COMMIT: ${{ inputs.commit }}\n          SOURCE_REPO: ${{ inputs.repo }}\n        run: python tooling/scripts/package_bundle.py\n\n      # The gate, run on the finished zip rather than the build tree: packaging\n      # copies files in after signing, so the zip is the only thing that proves\n      # what ships.\n      - name: Verify every PE in the bundle is signed\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Continue'\n          $zips = @(Get-ChildItem dist -Filter *.zip -ErrorAction SilentlyContinue |\n            ForEach-Object { $_.FullName })\n          if ($zips.Count -eq 0) {\n            Write-Host '::error::no bundle in dist/; packaging produced nothing to verify'\n            exit 1\n          }\n          & tooling/.github/scripts/assert-windows-bundle-signed.ps1 -Path $zips\n          exit $LASTEXITCODE\n\n      # GPU bundles are built and shipped un-run: the Windows Vulkan runner has\n      # no GPU, so there is nothing to validate here, matching unslothai/llama.cpp.\n      - name: Upload bundle artifact\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6.0.0\n        with:\n          name: whisper-${{ inputs.tag }}-windows-x64-vulkan\n          path: dist/whisper-${{ inputs.tag }}-windows-x64-vulkan.zip\n          if-no-files-found: error\n          retention-days: 7\n"
