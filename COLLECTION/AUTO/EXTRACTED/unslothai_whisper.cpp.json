      "score": 126,
      "content": "# SPDX-License-Identifier: AGPL-3.0-only\n# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.\n\nname: \"Unsloth whisper prebuilt: CUDA\"\n\n# Reusable child of unsloth-prebuilt.yml (P1). Per-profile Linux CUDA\n# whisper-server bundles (x64 + arm64) filtered into `matrix` by the parent. The\n# coverage-profile names mirror unslothai/llama.cpp (cuda12-legacy/older/newer/\n# portable, cuda13-older/newer/portable) so the Studio installer can pick a\n# whisper bundle from the same profile it already resolved for llama.cpp.\n#\n# GPU bundles are DYNAMIC and use GGML_BACKEND_DL: the CUDA backend ships as a\n# dlopen'd libggml-cuda.so module, so the binary still loads and runs on CPU\n# when no device / CUDA runtime is present (Studio appends --no-gpu during\n# training). The CUDA runtime (libcudart/libcublas) is intentionally NOT bundled\n# -- the installer pairs it with the user's PyTorch CUDA runtime.\n\non:\n  workflow_call:\n    inputs:\n      tag:            { required: true,  type: string }\n      upstream_tag:   { required: true,  type: string }\n      repo:           { required: false, type: string, default: 'unslothai/whisper.cpp' }\n      commit:         { required: true,  type: string }\n      source_artifact: { required: true,  type: string }\n      matrix:         { required: true,  type: string }\n\npermissions:\n  contents: read\n\nenv:\n  WHISPER_MODEL_URL: \"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin\"\n\njobs:\n  build:\n    name: ${{ matrix.arch }}/${{ matrix.profile }}\n    runs-on: ${{ matrix.runner }}\n    strategy:\n      fail-fast: false\n      matrix: ${{ fromJSON(inputs.matrix) }}\n    steps:\n      - name: Free disk space\n        uses: jlumbroso/free-disk-space@54081f138730dfa15788a46383842cd2f914a1be  # v1.3.1\n        with:\n          tool-cache: true\n          android: true\n          dotnet: true\n          haskell: true\n          large-packages: false\n          swap-storage: true\n\n      - name: Checkout build tooling (this repo)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { path: tooling }\n\n      - name: Download stamped source @ ${{ inputs.tag }}\n        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53  # v6.0.0\n        with: { name: \"${{ inputs.source_artifact }}\", path: srcpkg }\n      - name: Extract source\n        run: |\n          set -eux\n          mkdir -p src\n          tar -xzf \"srcpkg/whisper.cpp-source-${{ inputs.tag }}.tar.gz\" -C src --strip-components=1\n\n      - name: Install build dependencies\n        run: |\n          set -eux\n          sudo apt-get update\n          sudo apt-get install -y build-essential ninja-build\n\n      - name: Install ARM64 host compiler (gcc-14)\n        if: matrix.arch == 'arm64'\n        run: |\n          set -eux\n          sudo apt-get install -y gcc-14 g++-14\n          { echo \"CC=gcc-14\"; echo \"CXX=g++-14\"; echo \"CUDAHOSTCXX=g++-14\"; } >> \"$GITHUB_ENV\"\n\n      - name: ccache\n        uses: hendrikmuhs/ccache-action@5ebbd400eff9e74630f759d94ddd7b6c26299639  # v1.2.20\n        with: { key: \"cuda-${{ matrix.cuda }}-${{ matrix.arch }}-${{ matrix.profile }}\", variant: ccache, evict-old-files: 14d }\n\n      # Jimver has no CUDA 13.3 mapping, so pull that toolkit from the NVIDIA\n      # redist CDN by hand (same runner, so the glibc floor is unchanged).\n      - name: Install CUDA toolkit 13.3 (NVIDIA redist)\n        if: matrix.cuda == '13.3'\n        run: |\n          set -eux\n          case \"${{ matrix.arch }}\" in\n            x64)   PLAT=linux-x86_64 ;;\n            arm64) PLAT=linux-sbsa ;;\n            *) echo \"unsupported arch\" >&2; exit 1 ;;\n          esac\n          PREFIX=\"$HOME/cuda-13.3\"; mkdir -p \"$PREFIX\"\n          BASE=\"https://developer.download.nvidia.com/compute/cuda/redist\"\n          for cv in cuda_crt:13.3.33 cuda_cudart:13.3.29 cuda_nvcc:13.3.33 \\\n                    cuda_nvrtc:13.3.33 libcublas:13.5.1.27 libnvvm:13.3.33 \\\n                    cuda_nvtx:13.3.29 cuda_profiler_api:13.3.27 cccl:13.3.3.3.1; do\n            comp=\"${cv%:*}\"; ver=\"${cv#*:}\"; name=\"${comp}-${PLAT}-${ver}-archive\"\n            curl -fsSL -o comp.tar.xz \"$BASE/${comp}/${PLAT}/${name}.tar.xz\"\n            tar -xf comp.tar.xz; cp -a \"${name}/.\" \"$PREFIX\"/; rm -rf comp.tar.xz \"${name}\"\n          done\n          ln -sfn lib \"$PREFIX/lib64\"\n          { echo \"CUDA_PATH=$PREFIX\"; echo \"CUDA_HOME=$PREFIX\"; echo \"LD_LIBRARY_PATH=$PREFIX/lib:${LD_LIBRARY_PATH:-}\"; } >> \"$GITHUB_ENV\"\n          echo \"$PREFIX/bin\" >> \"$GITHUB_PATH\"\n\n      - name: Install CUDA toolkit ${{ matrix.cuda }} (Jimver)\n        if: matrix.cuda != '13.3'\n        uses: Jimver/cuda-toolkit@3d45d157f327c09c04b50ee6ccdea2d9d017ec76  # v0.2.35\n        id: cuda-toolkit\n        with: { cuda: \"${{ matrix.cuda }}\", method: network }\n\n      - name: Set up CUDA environment (Jimver)\n        if: matrix.cuda != '13.3'\n        run: |\n          echo \"CUDA_PATH=${{ steps.cuda-toolkit.outputs.CUDA_PATH }}\" >> \"$GITHUB_ENV\"\n          echo \"CUDA_HOME=${{ steps.cuda-toolkit.outputs.CUDA_PATH }}\" >> \"$GITHUB_ENV\"\n          echo \"LD_LIBRARY_PATH=${{ steps.cuda-toolkit.outputs.CUDA_PATH }}/lib64:${LD_LIBRARY_PATH:-}\" >> \"$GITHUB_ENV\"\n\n      - name: Verify CUDA\n        run: nvcc --version\n\n      - name: Configure + build (dynamic, backend-DL, CPU fallback)\n        working-directory: src\n        run: |\n          set -eux\n          cmake -S . -B build -G Ninja \\\n            -DCMAKE_BUILD_TYPE=Release \\\n            -DBUILD_SHARED_LIBS=ON \\\n            -DGGML_NATIVE=OFF \\\n            -DGGML_BACKEND_DL=ON \\\n            -DGGML_CPU_ALL_VARIANTS=ON \\\n            -DGGML_CUDA=ON \\\n            -DWHISPER_BUILD_EXAMPLES=ON \\\n            -DWHISPER_BUILD_SERVER=ON \\\n            -DWHISPER_BUILD_TESTS=OFF \\\n            -DWHISPER_SDL2=OFF \\\n            -DCMAKE_CUDA_ARCHITECTURES=\"$(echo '${{ matrix.archs }}' | tr ' ' ';')\" \\\n            -DCMAKE_INSTALL_RPATH='$ORIGIN' \\\n            -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \\\n            -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=OFF \\\n            -DCMAKE_C_COMPILER_LAUNCHER=ccache \\\n            -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \\\n            -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache\n          cmake --build build --config Release --target whisper-server -j 3\n          strip build/bin/whisper-server || true\n\n      - name: Package bundle\n        env:\n          OS: linux\n          ARCH: ${{ matrix.arch }}\n          ACCEL: ${{ matrix.profile }}\n          BACKEND: cuda\n          RUNTIME_LINE: ${{ matrix.line }}\n          COVERAGE_CLASS: ${{ matrix.klass }}\n          SMS: ${{ matrix.sms }}\n          MIN_OS: ${{ matrix.arch == 'arm64' && 'glibc-2.39' || 'glibc-2.35' }}\n          BIN_DIR: ${{ github.workspace }}/src/build/bin\n          SRC_DIR: ${{ github.workspace }}/src\n          OUT_DIR: ${{ github.workspace }}/dist\n          TAG: ${{ inputs.tag }}\n          UPSTREAM_TAG: ${{ inputs.upstream_tag }}\n          SOURCE_COMMIT: ${{ inputs.commit }}\n          SOURCE_REPO: ${{ inputs.repo }}\n        run: python3 tooling/scripts/package_bundle.py\n\n      # GPU bundles are built and shipped un-run: GitHub-hosted CUDA runners have\n      # no GPU (and no NVIDIA driver), so there is nothing to validate here, the\n      # same as unslothai/llama.cpp's CUDA release job. Real GPU inference is a\n      # separate self-hosted accelerator job (see README).\n      - name: Upload bundle artifact\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6.0.0\n        with:\n          name: whisper-${{ inputs.tag }}-linux-${{ matrix.arch }}-${{ matrix.profile }}\n          path: dist/whisper-${{ inputs.tag }}-linux-${{ matrix.arch }}-${{ matrix.profile }}.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n"
