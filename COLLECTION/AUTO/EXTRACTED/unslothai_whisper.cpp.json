    {
      "path": ".github/workflows/unsloth-prebuilt-macos.yml",
      "sha": null,
      "content_sha256": "dd5a89892ffcf2569ea3dd73c390ef6866110eb0492f4e44de8f08ed55f701a9",
      "score": 126,
      "content": "# SPDX-License-Identifier: AGPL-3.0-only\n# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.\n\nname: \"Unsloth whisper prebuilt: macOS\"\n\n# Reusable child of unsloth-prebuilt.yml. Builds the macOS slices the parent's\n# resolve job placed in `matrix`: arm64 Metal (P0) and x64 CPU (P0). Per-slice\n# knobs (defines / shared / static / deploy_target) come from that matrix:\n#   arm64 Metal: STATIC single-file, Metal shader library EMBEDDED\n#     (-DGGML_METAL_EMBED_LIBRARY=ON, +BF16) so the bundle needs no\n#     default.metallib beside the binary; Apple Silicon is one CPU baseline so a\n#     variant set buys nothing.\n#   x64 CPU: DYNAMIC (GGML_BACKEND_DL + GGML_CPU_ALL_VARIANTS) so the x86-64\n#     microarch dispatch matches the Linux/Windows x64 CPU bundles; @loader_path\n#     rpath resolves the co-located dylibs from the binary's own directory.\n# Each slice pins an explicit -DCMAKE_OSX_DEPLOYMENT_TARGET so the binary\n# declares a loadable floor instead of inheriting the (newer) runner OS. Only\n# whisper-server is built.\n\non:\n  workflow_call:\n    inputs:\n      tag:            { required: true,  type: string }\n      upstream_tag:   { required: true,  type: string }\n      repo:           { required: false, type: string, default: 'unslothai/whisper.cpp' }\n      commit:         { required: true,  type: string }\n      source_artifact: { required: true,  type: string }\n      matrix:         { required: true,  type: string }\n\npermissions:\n  contents: read\n\nenv:\n  WHISPER_MODEL_URL: \"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin\"\n\njobs:\n  build:\n    name: ${{ matrix.build }}\n    runs-on: ${{ matrix.runner }}\n    strategy:\n      fail-fast: false\n      matrix: ${{ fromJSON(inputs.matrix) }}\n    steps:\n      - name: Checkout build tooling (this repo)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { path: tooling, persist-credentials: false }\n\n      - name: Download stamped source @ ${{ inputs.tag }}\n        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53  # v6.0.0\n        with: { name: \"${{ inputs.source_artifact }}\", path: srcpkg }\n      - name: Extract source\n        run: |\n          set -eux\n          mkdir -p src\n          tar -xzf \"srcpkg/whisper.cpp-source-${{ inputs.tag }}.tar.gz\" -C src --strip-components=1\n\n      - name: Configure + build (deployment target ${{ matrix.deploy_target }})\n        working-directory: src\n        run: |\n          set -euo pipefail\n          cmake -B build \\\n            ${{ matrix.defines }} \\\n            -DCMAKE_BUILD_TYPE=Release \\\n            -DBUILD_SHARED_LIBS=${{ matrix.shared }} \\\n            -DGGML_NATIVE=OFF \\\n            -DWHISPER_BUILD_EXAMPLES=ON \\\n            -DWHISPER_BUILD_SERVER=ON \\\n            -DWHISPER_BUILD_TESTS=OFF \\\n            -DWHISPER_SDL2=OFF \\\n            -DCMAKE_OSX_DEPLOYMENT_TARGET=${{ matrix.deploy_target }} \\\n            -DCMAKE_INSTALL_RPATH='@loader_path' \\\n            -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON\n          cmake --build build --config Release --target whisper-server -j \"$(sysctl -n hw.logicalcpu)\"\n\n      - name: Verify arch + deployment floor\n        run: |\n          set -eux\n          BIN=src/build/bin/whisper-server\n          file \"$BIN\" | grep -q \"${{ matrix.expect_arch }}\" || { echo \"unexpected arch\" >&2; exit 1; }\n          # Assert the LC_BUILD_VERSION / LC_VERSION_MIN minos does not exceed the\n          # pinned deployment target, so the binary loads on that macOS floor.\n          MINOS=\"$(otool -l \"$BIN\" | awk '/LC_BUILD_VERSION|LC_VERSION_MIN_MACOSX/{f=1} f&&/minos|version/{print $2; f=0}' | head -1)\"\n          echo \"minos=$MINOS target=${{ matrix.deploy_target }}\"\n          [ -n \"$MINOS\" ] || { echo \"could not read minos from $BIN\" >&2; exit 1; }\n          awk -v m=\"$MINOS\" -v t=\"${{ matrix.deploy_target }}\" 'BEGIN {\n            split(m, a, \".\"); split(t, b, \".\")\n            exit (a[1] * 100 + a[2] > b[1] * 100 + b[2]) ? 1 : 0\n          }' || { echo \"minos $MINOS exceeds deploy target ${{ matrix.deploy_target }}\" >&2; exit 1; }\n\n      - name: Package bundle\n        env:\n          OS: macos\n          ARCH: ${{ matrix.build }}\n          ACCEL: ${{ matrix.accel }}\n          BACKEND: ${{ matrix.backend }}\n          STATIC: ${{ matrix.static }}\n          MIN_OS: \"macos-${{ matrix.deploy_target }}\"\n          BIN_DIR: ${{ github.workspace }}/src/build/bin\n          SRC_DIR: ${{ github.workspace }}/src\n          OUT_DIR: ${{ github.workspace }}/dist\n          TAG: ${{ inputs.tag }}\n          UPSTREAM_TAG: ${{ inputs.upstream_tag }}\n          SOURCE_COMMIT: ${{ inputs.commit }}\n          SOURCE_REPO: ${{ inputs.repo }}\n        run: python3 tooling/scripts/package_bundle.py\n\n      # macOS runners are native and (for arm64) carry a Metal GPU, so validate\n      # real inference plus the mandatory --no-gpu fallback.\n      - name: Validate bundle (help + closure + transcription + --no-gpu)\n        run: |\n          set -eux\n          mkdir -p bundle model\n          tar -xzf \"dist/whisper-${{ inputs.tag }}-macos-${{ matrix.build }}-${{ matrix.accel }}.tar.gz\" -C bundle\n          curl -fsSL \"$WHISPER_MODEL_URL\" -o model/ggml-tiny.en.bin\n          python3 tooling/scripts/validate_bundle.py \\\n            --bundle bundle --model model/ggml-tiny.en.bin --audio src/samples/jfk.wav\n\n      - name: Upload bundle artifact\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6.0.0\n        with:\n          name: whisper-${{ inputs.tag }}-macos-${{ matrix.build }}-${{ matrix.accel }}\n          path: dist/whisper-${{ inputs.tag }}-macos-${{ matrix.build }}-${{ matrix.accel }}.tar.gz\n          if-no-files-found: error\n          retention-days: 7\n"
    },
    {
      "path": ".github/workflows/unsloth-prebuilt-deadman.yml",
      "sha": null,
      "content_sha256": "299263dcff2cccd9f3f957580306f3b9e377177f7c19640945e52837d2b29d7c",
      "score": 126,
      "content": "# SPDX-License-Identifier: AGPL-3.0-only\n# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.\n\nname: Unsloth prebuilt dead-man check\n\n# The worst failure mode here is a green run, not a red one: on 08-01 and 08-02\n# the staleness check found no pairing to compare, decided there was nothing to\n# do, and exited 0. Nothing keyed off job failure can see that.\n#\n# It asks the question Studio setup asks: does the newest whisper release still\n# load against the newest llama release, comparing the ggml tree ids both sides\n# now record. STALE_DAYS survives only as a fallback for releases predating\n# those fields, where the honest answer is that the pairing is unknown.\n\non:\n  schedule:\n    - cron: '37 9 * * *'\n  workflow_dispatch:\n\npermissions:\n  contents: read\n  issues: write\n\nenv:\n  # Only used when the pairing cannot be compared; the pairing check below is\n  # the real signal and does not care how long ago whisper last published.\n  STALE_DAYS: '7'\n  # How long llama may sit newer than whisper before that counts as a fault\n  # rather than a rebuild in progress.\n  PAIRING_GRACE_HOURS: '6'\n\njobs:\n  deadman:\n    name: Check publish freshness\n    runs-on: ubuntu-22.04\n    steps:\n      - name: Checkout (for the composite action)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { persist-credentials: false }\n\n      - name: Check newest published release\n        id: c\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -uo pipefail\n          LATEST=\"$(gh api \"repos/${GITHUB_REPOSITORY}/releases?per_page=30\" \\\n            --jq '[.[] | select(.draft==false and .prerelease==false)]\n                  | max_by(.published_at|fromdateiso8601)\n                  | \"\\(.tag_name)\\t\\(.published_at)\"' 2>/dev/null || true)\"\n\n          if [ -z \"$LATEST\" ] || [ \"$LATEST\" = \"null\" ]; then\n            echo \"::warning::could not read the release list; skipping this check\"\n            echo \"status=skip\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          TAG=\"${LATEST%%$'\\t'*}\"\n          PUB=\"${LATEST##*$'\\t'}\"\n          AGE_D=$(( ( $(date -u +%s) - $(date -u -d \"$PUB\" +%s) ) / 86400 ))\n\n          # --clobber: without it gh refuses to overwrite and the failure is\n          # swallowed below, leaving a stale manifest to be read as current.\n          gh release download \"$TAG\" --repo \"$GITHUB_REPOSITORY\" --clobber \\\n            --pattern whisper-prebuilt-manifest.json --output \"${RUNNER_TEMP}/w.json\" 2>/dev/null || true\n          slim() { jq -r \"first(.artifacts[]? | select(.install_kind == \\\"slim\\\") | .$1) // empty\" \\\n                     \"${RUNNER_TEMP}/w.json\" 2>/dev/null || true; }\n          PAIRED=\"$(slim requires_llama_tag)\"; PAIRED=\"${PAIRED:-unreadable}\"\n          OUR_TREE=\"$(slim requires_ggml_tree)\"\n          LLAMA=\"$(gh api 'repos/unslothai/llama.cpp/releases?per_page=30' \\\n            --jq '[.[] | select(.draft==false and .prerelease==false)]\n                  | max_by(.published_at|fromdateiso8601) | \"\\(.tag_name)\\t\\(.published_at)\"' 2>/dev/null || true)\"\n          LLAMA_NOW=\"${LLAMA%%$'\\t'*}\"; LLAMA_PUB=\"${LLAMA##*$'\\t'}\"\n          LLAMA_TREE=\"$(gh release download \"${LLAMA_NOW}\" --repo unslothai/llama.cpp \\\n            --pattern llama-prebuilt-manifest.json --output - 2>/dev/null \\\n            | jq -r '.ggml_tree // empty' 2>/dev/null || true)\"\n          echo \"newest ${TAG} (${AGE_D}d old) requires ggml tree ${OUR_TREE:-unknown} via ${PAIRED}\"\n          echo \"newest llama ${LLAMA_NOW:-unknown} carries ggml tree ${LLAMA_TREE:-unknown}\"\n\n          # The real question is not \"has whisper published recently\" but \"does\n          # what it published still load against the llama Studio installs\".\n          # Only ask it when both sides actually state a tree; a release from\n          # before llama recorded one says nothing either way, and guessing\n          # there is how the -mix- comparison got this wrong for five days.\n          if [ -n \"$OUR_TREE\" ] && [ -n \"$LLAMA_TREE\" ]; then\n            if [ \"$OUR_TREE\" = \"$LLAMA_TREE\" ]; then\n              echo \"paired; nothing to do\"\n              echo \"status=success\" >> \"$GITHUB_OUTPUT\"\n              echo \"details=\" >> \"$GITHUB_OUTPUT\"\n              exit 0\n            fi\n            # A llama release published minutes ago has not had time to wake\n            # whisper and build, so only complain once the rebuild is overdue.\n            LLAMA_AGE_H=$(( ( $(date -u +%s) - $(date -u -d \"$LLAMA_PUB\" +%s) ) / 3600 ))\n            if [ \"$LLAMA_AGE_H\" -le \"${PAIRING_GRACE_HOURS}\" ]; then\n              echo \"unpaired, but ${LLAMA_NOW} is only ${LLAMA_AGE_H}h old; within the rebuild window\"\n              echo \"status=success\" >> \"$GITHUB_OUTPUT\"\n              echo \"details=\" >> \"$GITHUB_OUTPUT\"\n              exit 0\n            fi\n            echo \"status=failure\" >> \"$GITHUB_OUTPUT\"\n            {\n              echo 'details<<ALERT_EOF'\n              echo \"The newest whisper prebuilt no longer pairs with the newest llama prebuilt, so Studio setup reports \\`no compatible prebuilt\\` and falls back to Transformers dictation.\"\n              echo\n              echo \"| | | |\"\n              echo \"|---|---|---|\"\n              echo \"| whisper | \\`${TAG}\\` | needs ggml tree \\`${OUR_TREE}\\` |\"\n              echo \"| llama | \\`${LLAMA_NOW}\\` | ships ggml tree \\`${LLAMA_TREE}\\` |\"\n              echo\n              echo \"\\`${LLAMA_NOW}\\` has been published for ${LLAMA_AGE_H}h and whisper has not rebuilt against it. Check whether llama's notify step fired and whether the dispatch reached this repo.\"\n              echo 'ALERT_EOF'\n            } >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          # One side does not state a tree, so fall back to plain staleness.\n          echo \"pairing not comparable; falling back to the ${STALE_DAYS}d staleness check\"\n          if [ \"$AGE_D\" -le \"${STALE_DAYS}\" ]; then\n            echo \"status=success\" >> \"$GITHUB_OUTPUT\"\n            echo \"details=\" >> \"$GITHUB_OUTPUT\"\n            exit 0\n          fi\n\n          echo \"status=failure\" >> \"$GITHUB_OUTPUT\"\n          {\n            echo 'details<<ALERT_EOF'\n            echo \"No whisper prebuilt has been published in **${AGE_D} days** (threshold ${STALE_DAYS}).\"\n            echo\n            echo \"| | |\"\n            echo \"|---|---|\"\n            echo \"| newest whisper release | \\`${TAG}\\`, published ${PUB} |\"\n            echo \"| it requires llama | \\`${PAIRED}\\` |\"\n            echo \"| newest llama release | \\`${LLAMA_NOW}\\` |\"\n            echo\n            echo \"If those two llama tags differ, Studio setup is reporting\"\n            echo \"\\`no compatible prebuilt\\` and falling back to Transformers dictation.\"\n            echo 'ALERT_EOF'\n          } >> \"$GITHUB_OUTPUT\"\n\n      - name: Alert\n        if: ${{ steps.c.outputs.status != 'skip' }}\n        uses: ./.github/actions/prebuilt-alert\n        with:\n          status: ${{ steps.c.outputs.status }}\n          key: whisper-prebuilt-stale\n          title: 'whisper.cpp prebuilts are out of date'\n          details: ${{ steps.c.outputs.details }}\n          token: ${{ github.token }}\n"
    }
