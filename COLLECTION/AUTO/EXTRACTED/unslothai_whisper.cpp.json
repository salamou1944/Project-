      "content": "# SPDX-License-Identifier: AGPL-3.0-only\n# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved.\n\nname: \"Unsloth whisper prebuilt: CUDA Windows\"\n\n# Reusable child of unsloth-prebuilt.yml (P1). Per-profile Windows x64 CUDA\n# whisper-server bundles filtered into `matrix` by the parent. Mirrors the Linux\n# CUDA child on the MSVC + Ninja toolchain: dynamic build, GGML_BACKEND_DL so\n# the CUDA backend is a dlopen'd module (CPU fallback works with --no-gpu), no\n# RPATH (Windows loads sibling DLLs from the exe dir), .zip archive. CUDA\n# compiles in software here -- no GPU is present on the runner. The CUDA runtime\n# (cudart/cublas DLLs) is NOT bundled; the installer pairs it with the user's\n# PyTorch CUDA runtime.\n\non:\n  workflow_call:\n    inputs:\n      tag:            { required: true,  type: string }\n      upstream_tag:   { required: true,  type: string }\n      repo:           { required: false, type: string, default: 'unslothai/whisper.cpp' }\n      commit:         { required: true,  type: string }\n      source_artifact: { required: true,  type: string }\n      matrix:         { required: true,  type: string }\n\n    secrets:\n      # Optional so a fork can still run the build; the composite action fails\n      # closed on unslothai itself, where an unsigned publish is the actual\n      # hazard. See .github/actions/sign-windows.\n      AZURE_CLIENT_ID:                     { required: false }\n      AZURE_CLIENT_SECRET:                 { required: false }\n      AZURE_TENANT_ID:                     { required: false }\n      AZURE_TRUSTED_SIGNING_ACCOUNT_NAME:  { required: false }\n      AZURE_CERTIFICATE_PROFILE_NAME:      { required: false }\n\npermissions:\n  contents: read\n\nenv:\n  WHISPER_MODEL_URL: \"https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin\"\n\njobs:\n  build:\n    name: x64/${{ matrix.profile }}\n    runs-on: ${{ matrix.runner }}\n    # Gate on the environment, matching release-desktop.yml: the job that\n    # can read the signing credentials is named explicitly.\n    environment: release-signing\n    strategy:\n      fail-fast: false\n      matrix: ${{ fromJSON(inputs.matrix) }}\n    defaults:\n      run: { shell: pwsh }\n    steps:\n      - name: Checkout build tooling (this repo)\n        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803  # v6.1.0\n        with: { path: tooling }\n\n      - name: Download stamped source @ ${{ inputs.tag }}\n        uses: actions/download-artifact@018cc2cf5baa6db3ef3c5f8a56943fffe632ef53  # v6.0.0\n        with: { name: \"${{ inputs.source_artifact }}\", path: srcpkg }\n      - name: Extract source\n        shell: bash\n        run: |\n          set -eux\n          mkdir -p src\n          tar -xzf \"srcpkg/whisper.cpp-source-${{ inputs.tag }}.tar.gz\" -C src --strip-components=1\n\n      - name: ccache\n        uses: hendrikmuhs/ccache-action@5ebbd400eff9e74630f759d94ddd7b6c26299639  # v1.2.20\n        with: { key: \"cuda-${{ matrix.cuda }}-windows-${{ matrix.profile }}\", variant: ccache, evict-old-files: 14d }\n\n      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1  # v6.3.0\n        with: { python-version: \"3.11\" }\n\n      - name: Install Ninja\n        run: choco install ninja --no-progress\n\n      - name: Setup MSVC\n        uses: ilammy/msvc-dev-cmd@0b201ec74fa43914dc39ae48a89fd1d8cb592756  # v1.13.0\n\n      # Jimver has no CUDA 13.3 mapping; assemble it from the NVIDIA redist\n      # component archives (block mirrors ggml-org's windows-setup-cuda).\n      - name: Install CUDA toolkit 13.3 (NVIDIA redist)\n        if: matrix.cuda == '13.3'\n        run: |\n          $dst = \"C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v13.3\"\n          New-Item -ItemType Directory -Force -Path $dst | Out-Null\n          choco install unzip -y\n          $base = \"https://developer.download.nvidia.com/compute/cuda/redist\"\n          $comps = @(\n            \"cuda_crt/windows-x86_64/cuda_crt-windows-x86_64-13.3.33-archive.zip\",\n            \"cuda_cudart/windows-x86_64/cuda_cudart-windows-x86_64-13.3.29-archive.zip\",\n            \"cuda_nvcc/windows-x86_64/cuda_nvcc-windows-x86_64-13.3.33-archive.zip\",\n            \"cuda_nvrtc/windows-x86_64/cuda_nvrtc-windows-x86_64-13.3.33-archive.zip\",\n            \"libcublas/windows-x86_64/libcublas-windows-x86_64-13.5.1.27-archive.zip\",\n            \"libnvvm/windows-x86_64/libnvvm-windows-x86_64-13.3.33-archive.zip\",\n            \"cuda_nvtx/windows-x86_64/cuda_nvtx-windows-x86_64-13.3.29-archive.zip\",\n            \"cuda_profiler_api/windows-x86_64/cuda_profiler_api-windows-x86_64-13.3.27-archive.zip\",\n            \"visual_studio_integration/windows-x86_64/visual_studio_integration-windows-x86_64-13.3.27-archive.zip\",\n            \"cccl/windows-x86_64/cccl-windows-x86_64-13.3.3.3.1-archive.zip\"\n          )\n          foreach ($c in $comps) {\n            $fn = Split-Path $c -Leaf\n            curl.exe -fsSL -o $fn \"$base/$c\"\n            unzip -q $fn -d $dst\n            $sub = Join-Path $dst ($fn -replace '\\.zip$','')\n            xcopy \"$sub\\*\" \"$dst\" /E /I /H /Y | Out-Null\n          }\n          echo \"$dst\\bin\" | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append\n          echo \"CUDA_PATH=$dst\" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8\n\n      - name: Install CUDA toolkit ${{ matrix.cuda }} (Jimver)\n        if: matrix.cuda != '13.3'\n        uses: Jimver/cuda-toolkit@3d45d157f327c09c04b50ee6ccdea2d9d017ec76  # v0.2.35\n        id: cuda-toolkit\n        with: { cuda: \"${{ matrix.cuda }}\", method: network }\n\n      - name: Set up CUDA environment (Jimver)\n        if: matrix.cuda != '13.3'\n        run: |\n          echo \"CUDA_PATH=$env:CUDA_PATH\" >> $env:GITHUB_ENV\n          echo \"CUDA_HOME=$env:CUDA_PATH\" >> $env:GITHUB_ENV\n\n      - name: Verify CUDA\n        run: nvcc --version\n\n      - name: Configure + build (dynamic, backend-DL, CPU fallback)\n        working-directory: src\n        run: |\n          $archs = \"${{ matrix.archs }}\".Replace(' ', ';')\n          cmake -S . -B build -G Ninja `\n            -DCMAKE_BUILD_TYPE=Release `\n            -DBUILD_SHARED_LIBS=ON `\n            -DGGML_NATIVE=OFF `\n            -DGGML_BACKEND_DL=ON `\n            -DGGML_CPU_ALL_VARIANTS=ON `\n            -DGGML_CUDA=ON `\n            -DGGML_OPENMP=OFF `\n            -DWHISPER_BUILD_EXAMPLES=ON `\n            -DWHISPER_BUILD_SERVER=ON `\n            -DWHISPER_BUILD_TESTS=OFF `\n            -DWHISPER_SDL2=OFF `\n            -DCMAKE_CUDA_ARCHITECTURES=\"$archs\" `\n            -DCMAKE_C_COMPILER_LAUNCHER=ccache `\n            -DCMAKE_CXX_COMPILER_LAUNCHER=ccache `\n            -DCMAKE_CUDA_COMPILER_LAUNCHER=ccache\n          cmake --build build --config Release --target whisper-server -j 3\n\n      # Before packaging, so every DLL the bundle carries is signed and not\n      # just the server executable. Windows Smart App Control evaluates each\n      # binary as it loads: an unsigned dependent DLL is refused with status\n      # 0xc0e90002 and surfaces as a \"Bad Image\" dialog naming that DLL.\n      - name: Sign Windows binaries\n        uses: ./tooling/.github/actions/sign-windows\n        with:\n          path: src/build/bin\n          azure-client-id: ${{ secrets.AZURE_CLIENT_ID }}\n          azure-client-secret: ${{ secrets.AZURE_CLIENT_SECRET }}\n          azure-tenant-id: ${{ secrets.AZURE_TENANT_ID }}\n          azure-account: ${{ secrets.AZURE_TRUSTED_SIGNING_ACCOUNT_NAME }}\n          azure-certificate-profile: ${{ secrets.AZURE_CERTIFICATE_PROFILE_NAME }}\n\n      - name: Package bundle\n        env:\n          OS: windows\n          ARCH: x64\n          ACCEL: ${{ matrix.profile }}\n          BACKEND: cuda\n          RUNTIME_LINE: ${{ matrix.line }}\n          COVERAGE_CLASS: ${{ matrix.klass }}\n          SMS: ${{ matrix.sms }}\n          MIN_OS: \"windows-10\"\n          BIN_DIR: ${{ github.workspace }}/src/build/bin\n          SRC_DIR: ${{ github.workspace }}/src\n          OUT_DIR: ${{ github.workspace }}/dist\n          TAG: ${{ inputs.tag }}\n          UPSTREAM_TAG: ${{ inputs.upstream_tag }}\n          SOURCE_COMMIT: ${{ inputs.commit }}\n          SOURCE_REPO: ${{ inputs.repo }}\n        run: python tooling/scripts/package_bundle.py\n\n      # The gate, run on the finished zip rather than the build tree: packaging\n      # copies files in after signing, so the zip is the only thing that proves\n      # what ships.\n      - name: Verify every PE in the bundle is signed\n        shell: pwsh\n        run: |\n          $ErrorActionPreference = 'Continue'\n          $zips = @(Get-ChildItem dist -Filter *.zip -ErrorAction SilentlyContinue |\n            ForEach-Object { $_.FullName })\n          if ($zips.Count -eq 0) {\n            Write-Host '::error::no bundle in dist/; packaging produced nothing to verify'\n            exit 1\n          }\n          & tooling/.github/scripts/assert-windows-bundle-signed.ps1 -Path $zips\n          exit $LASTEXITCODE\n\n      # GPU bundles are built and shipped un-run: the Windows CUDA runner has no\n      # GPU/driver, so there is nothing to validate here, matching\n      # unslothai/llama.cpp's Windows CUDA release job.\n      - name: Upload bundle artifact\n        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f  # v6.0.0\n        with:\n          name: whisper-${{ inputs.tag }}-windows-x64-${{ matrix.profile }}\n          path: dist/whisper-${{ inputs.tag }}-windows-x64-${{ matrix.profile }}.zip\n          if-no-files-found: error\n          retention-days: 7\n"
