      "content": "\n// OpenMPI sync test\n#include <mpi.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n\nint main(int argc, char** argv) {\n\n  MPI_Init(NULL, NULL);\n\n  int world_rank;\n  MPI_Comm_rank(MPI_COMM_WORLD, &world_rank);\n  int world_size;\n  MPI_Comm_size(MPI_COMM_WORLD, &world_size);\n  int rtn = -1;\n  if (world_rank == 0) {\n      printf(\"Process 0 before MPI_Barrier\\n\");\n      rtn = MPI_Barrier(MPI_COMM_WORLD);\n      printf(\"Process 0 after MPI_Barrier rtn %d\\n\", rtn);\n  } else {\n      if (world_rank == 2)  usleep(5000000);\n      printf(\"Process %d before MPI_Barrier\\n\", world_rank);\n      rtn = MPI_Barrier(MPI_COMM_WORLD);\n      printf(\"Process %d after MPI_Barrier rtn %d\\n\", world_rank, rtn);\n  }\n  \n  MPI_Finalize();\n}\n\n\n"
