      "content": "package uk.co.voicehacker.app.practicewords;\n\nimport android.content.Context;\nimport android.content.Intent;\n\n/**\n * Created by Matt on 21-Apr-17.\n */\n\npublic class sound {\n    int buttonid;\n    String[] words = {};\n    int[] moreinfosections = {};\n    String symbol;\n    int soundfile;\n    String title;\n    int row;\n    int column;\n    int section;\n\n    public sound(int id, String sym, int file, String tit, int[] mIS, int col, int ro, int sec, String[] wordArr) {\n        buttonid = id;\n        words = wordArr;\n        symbol = sym;\n        soundfile = file;\n        moreinfosections = mIS;\n        title = tit;\n        row = ro;\n        column = col;\n        section = sec;\n\n    }\n}\n"
