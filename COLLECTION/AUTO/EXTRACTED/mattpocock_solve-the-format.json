      "content": "{\n  \"name\": \"solve-the-format_api\",\n  \"version\": \"1.0.0\",\n  \"scripts\": {\n    \"start\": \"nodemon index.js\"\n  },\n  \"dependencies\": {\n    \"axios\": \"^0.18.0\",\n    \"body-parser\": \"^1.18.3\",\n    \"cors\": \"^2.8.4\",\n    \"express\": \"^4.16.3\",\n    \"express-graphql\": \"^0.6.12\",\n    \"graphql\": \"^0.13.2\",\n    \"mongoose\": \"^5.2.4\"\n  }\n}\n"
