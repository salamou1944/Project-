      "content_sha256": "98c02fa8bca45e01ce3a22f4576170e8caf6b8772318cc8ae4942e9e4d5fd927",
      "score": 175,
      "content": "import { configure } from 'enzyme';\nimport Adapter from 'enzyme-adapter-react-16';\n\nconfigure({ adapter: new Adapter() });\n"
    },
    {
      "path": "api/bin/populateDatabase.js",
      "sha": null,
      "content_sha256": "0ea8c413565f8dd91bf74b36d3d96efc31daea2ebb3055ce27b5c5256c6c98e2",
      "score": 166,
      "content": "#!/usr/bin/env node\n\nconst axios = require(\"axios\");\nconst mongoose = require(\"mongoose\");\nconst config = require(\"../config.json\");\nmongoose.connect(\n  `mongodb://${config.dbuser}:${\n    config.dbpassword\n  }@ds247001.mlab.com:47001/solve_the_format`\n);\nconst CardModel = require(\"../models/Card\");\n\naxios\n  .get(\"https://api.magicthegathering.io/v1/cards?set=AKH&page=1\")\n  .then(({ data }) => {\n    data.cards.forEach(item => {\n      const card = new CardModel({ ...item });\n      card.save();\n    });\n  });\n"
    },
    {
      "path": "app/package.json",
      "sha": null,
      "content_sha256": "025aabd9ca531873fb56380eb87962704d7892b4043bed79e4779b3431e653ea",
      "score": 118,
      "content": "{\n  \"name\": \"default_app\",\n  \"main\": \"index.php\",\n  \"private\": true,\n  \"scripts\": {\n    \"watch\": \"webpack --watch --config webpack.dev.js\",\n    \"test\": \"jest --watchAll\",\n    \"build\": \"webpack --config webpack.prod.js\",\n    \"start\": \"webpack-dev-server --config webpack.dev.js\",\n    \"dev\": \"concurrently \\\"npm run start\\\" \\\"npm run test\\\"\"\n  },\n  \"devDependencies\": {\n    \"babel-core\": \"^6.26.3\",\n    \"babel-jest\": \"^22.4.3\",\n    \"babel-loader\": \"^7.1.4\",\n    \"babel-preset-env\": \"^1.6.1\",\n    \"babel-preset-react\": \"^6.24.1\",\n    \"chai\": \"^4.1.2\",\n    \"concurrently\": \"^3.6.0\",\n    \"css-loader\": \"^0.28.11\",\n    \"cssnano\": \"^3.10.0\",\n    \"enzyme\": \"^3.3.0\",\n    \"enzyme-adapter-react-16\": \"^1.1.1\",\n    \"eslint\": \"^4.19.1\",\n    \"eslint-config-airbnb\": \"^16.1.0\",\n    \"eslint-plugin-import\": \"^2.11.0\",\n    \"eslint-plugin-jsx-a11y\": \"^6.0.3\",\n    \"eslint-plugin-react\": \"^7.7.0\",\n    \"extract-text-webpack-plugin\": \"^4.0.0-beta.0\",\n    \"identity-obj-proxy\": \"^3.0.0\",\n    \"jest\": \"^22.4.3\",\n    \"node-sass\": \"^4.9.0\",\n    \"optimize-css-assets-webpack-plugin\": \"^4.0.2\",\n    \"regenerator-runtime\": \"^0.11.1\",\n    \"sass-loader\": \"^7.0.1\",\n    \"style-loader\": \"^0.21.0\",\n    \"uglifyjs-webpack-plugin\": \"^1.2.7\",\n    \"webpack\": \"^4.7.0\",\n    \"webpack-cli\": \"^2.1.2\",\n    \"webpack-dev-server\": \"^3.1.4\",\n    \"webpack-merge\": \"^4.1.3\"\n  },\n  \"dependencies\": {\n    \"apollo-boost\": \"^0.1.10\",\n    \"graphql\": \"^0.13.2\",\n    \"graphql-tag\": \"^2.9.2\",\n    \"prop-types\": \"^15.6.1\",\n    \"react\": \"^16.3.2\",\n    \"react-apollo\": \"^2.1.9\",\n    \"react-dom\": \"^16.3.2\"\n  },\n  \"jest\": {\n    \"setupTestFrameworkScriptFile\": \"./setUpTests.js\",\n    \"moduleNameMapper\": {\n      \"\\\\.(css|less|scss|sass)$\": \"identity-obj-proxy\"\n    },\n    \"coveragePathIgnorePatterns\": [\n      \"/node_modules/\"\n    ]\n  }\n}\n"
    },
    {
      "path": "api/index.js",
      "sha": null,
      "content_sha256": "a9f7e30cc380a6f60dd80820057d41bebffa1b9d2409dd2140fb08c7c6fec482",
      "score": 108,
      "content": "const express = require(\"express\");\nconst mongoose = require(\"mongoose\");\nconst graphqlHTTP = require(\"express-graphql\");\nconst cors = require(\"cors\");\nconst config = require(\"./config.json\");\nconst graphqlSchema = require(\"./graphql\");\n\nmongoose.connect(\n  `mongodb://${config.dbuser}:${\n    config.dbpassword\n  }@ds247001.mlab.com:47001/solve_the_format`\n);\n\nconst app = express();\n\napp.use(cors());\napp.use(express.json());\n\napp.use(\n  \"/\",\n  graphqlHTTP({\n    ...graphqlSchema,\n    graphiql: true\n  })\n);\n\napp.listen(6600);\n"
    },
