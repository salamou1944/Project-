      "content": "# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n# SPDX-License-Identifier: Apache-2.0\nFROM lmsysorg/sglang:v0.5.14-cu130@sha256:9611bd4c5624b0e9e17829506188a12f17205f2083de0dd44d6c521733553a50\nRUN rm -rf /sgl-workspace/sglang\nRUN (command -v git >/dev/null 2>&1) || \\\n    (apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \\\n     rm -rf /var/lib/apt/lists/*)\nRUN git clone https://github.com/sgl-project/sglang.git /code && cd /code && \\\n    git checkout 6c908b3a3ad5bf54d4a7bd877c9ce167eafb5e25\n# Agent import path; tests/prep.sh repeats this for the verifier environment.\nENV PYTHONPATH=\"/code/python\"\nWORKDIR /code\nRUN rm -rf .git && git init && \\\n    git config user.email \"agent@test\" && git config user.name \"Agent\" && \\\n    git add -A && git commit -m \"initial commit\"\nRUN mkdir -p /code/output\nENTRYPOINT []\n\n# Harbor verifier image; candidate /code is uploaded at runtime.\nWORKDIR /\nCOPY . /tests\nRUN chmod +x /tests/test.sh\nWORKDIR /code\n"
