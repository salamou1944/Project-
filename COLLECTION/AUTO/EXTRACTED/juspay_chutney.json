      "path": "secrets/secrets.nix",
      "sha": null,
      "content_sha256": "878515cf481e64c4e6cceb35cc667f719cb257ddf72e1b5857e5067f8b15b59e",
      "score": 78,
      "content": "let\n  shivaraj = \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFN5Ov2zDIG59/DaYKjT0sMWIY15er1DZCT9SIak07vK\";\n  srid = \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHQRxPoqlThDrkR58pKnJgmeWPY9/wleReRbZ2MOZRyd\";\n  subanesh = \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAjAcaMLTgi1G0NAWMM+ibKT82nyFWmSZ/FahXcpNb8w\";\n  admins = [ shivaraj srid subanesh ];\n\n  # Will change if the VPS is up/downgraded.\n  # In such a case, get the new public host key using `ssh-keyscan <host-address>` before deploying.\n  #\n  # TODO: Document this\n  chutney = \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFIA03zHMCUmJMCAbDHfkZmxbDOFkrbNMl2v6gJOn916\";\nin\n{\n  # Generated using https://docs.attic.rs/admin-guide/deployment/nixos.html#generating-the-credentials-file\n  \"attic/env.age\".publicKeys = admins ++ [ chutney ];\n  # Generated by running on `chutney`: `atticd-atticadm make-token --sub 'e2e-root' --validity '2y' --push '*' --pull '*' --delete '*' --create-cache '*' --destroy-cache '*' --configure-cache '*' --configure-cache-retention '*'`\n  \"attic/root-token.age\".publicKeys = admins;\n  # Assumes the cache is created by running: `nix run nixpkgs#attic-client cache create oss`\n  # Although not a necessity to create the token below, the cache is also made public by running: `nix run nixpkgs#attic-client -- cache configure oss --public`\n  # Generated by running on `chutney`: `atticd-atticadm make-token --sub oss-push --validity '2y' --pull oss --push oss`\n  \"attic/oss-push-token.age\".publicKeys = admins;\n  # AWS CLI config for developers: decrypted to `.aws/config` by `just aws-login`.\n  \"aws/config.age\".publicKeys = admins;\n}\n"
    },
