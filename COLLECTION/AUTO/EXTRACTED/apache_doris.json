"snapshot-id\" : 5566566556103729945\n  }, {\n    \"timestamp-ms\" : 1768815864885,\n    \"snapshot-id\" : 6929529550385335988\n  } ],\n  \"metadata-log\" : [ {\n    \"timestamp-ms\" : 1768815849261,\n    \"metadata-file\" : \"s3a://warehouse/wh/multi_catalog/equality_delete_par_3/metadata/00000-29c6157c-5288-4284-ac52-cdbc91d20857.metadata.json\"\n  }, {\n    \"timestamp-ms\" : 1768815854627,\n    \"metadata-file\" : \"s3a://warehouse/wh/multi_catalog/equality_delete_par_3/metadata/00001-c27a0f02-1f3c-4b48-b66f-f06c9eeba2a9.metadata.json\"\n  }, {\n    \"timestamp-ms\" : 1768815858121,\n    \"metadata-file\" : \"s3a://warehouse/wh/multi_catalog/equality_delete_par_3/metadata/00002-43e1a9b2-10e2-4cd5-ac78-730e1ae23d6b.metadata.json\"\n  }, {\n    \"timestamp-ms\" : 1768815861074,\n    \"metadata-file\" : \"s3a://warehouse/wh/multi_catalog/equality_delete_par_3/metadata/00003-2a5efa13-0059-47e3-85a1-9efee9272744.metadata.json\"\n  } ]\n}"
