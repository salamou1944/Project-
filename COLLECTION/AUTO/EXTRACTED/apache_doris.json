      "content": "{\n  \"format-version\" : 2,\n  \"table-uuid\" : \"fa14966d-8cf0-4bba-a659-9cf55daa817a\",\n  \"location\" : \"s3a://warehouse/wh/multi_catalog/equality_delete_par_3\",\n  \"last-sequence-number\" : 3,\n  \"last-updated-ms\" : 1768815864885,\n  \"last-column-id\" : 3,\n  \"current-schema-id\" : 1,\n  \"schemas\" : [ {\n    \"type\" : \"struct\",\n    \"schema-id\" : 0,\n    \"identifier-field-ids\" : [ 1, 2 ],\n    \"fields\" : [ {\n      \"id\" : 1,\n      \"name\" : \"id\",\n      \"required\" : true,\n      \"type\" : \"int\"\n    }, {\n      \"id\" : 2,\n      \"name\" : \"name\",\n      \"required\" : true,\n      \"type\" : \"string\"\n    }, {\n      \"id\" : 3,\n      \"name\" : \"data\",\n      \"required\" : true,\n      \"type\" : \"string\"\n    } ]\n  }, {\n    \"type\" : \"struct\",\n    \"schema-id\" : 1,\n    \"identifier-field-ids\" : [ 1, 2 ],\n    \"fields\" : [ {\n      \"id\" : 1,\n      \"name\" : \"new_id\",\n      \"required\" : true,\n      \"type\" : \"int\"\n    }, {\n      \"id\" : 2,\n      \"name\" : \"name\",\n      \"required\" : true,\n      \"type\" : \"string\"\n    }, {\n      \"id\" : 3,\n      \"name\" : \"data\",\n      \"required\" : true,\n      \"type\" : \"string\"\n    } ]\n  } ],\n  \"default-spec-id\" : 0,\n  \"partition-specs\" : [ {\n    \"spec-id\" : 0,\n    \"fields\" : [ ]\n  } ],\n  \"last-partition-id\" : 999,\n  \"default-sort-order-id\" : 0,\n  \"sort-orders\" : [ {\n    \"order-id\" : 0,\n    \"fields\" : [ ]\n  } ],\n  \"properties\" : {\n    \"write.parquet.compression-codec\" : \"zstd\",\n    \"write.upsert.enabled\" : \"true\"\n  },\n  \"current-snapshot-id\" : 6929529550385335988,\n  \"refs\" : {\n    \"main\" : {\n      \"snapshot-id\" : 6929529550385335988,\n      \"type\" : \"branch\"\n    }\n  },\n  \"snapshots\" : [ {\n    \"sequence-number\" : 1,\n    \"snapshot-id\" : 3871877879686571055,\n    \"timestamp-ms\" : 1768815854627,\n    \"summary\" : {\n      \"operation\" : \"overwrite