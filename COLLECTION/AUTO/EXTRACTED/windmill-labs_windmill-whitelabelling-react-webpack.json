  "files": [
    {
      "path": ".github/workflows/publish.yml",
      "sha": null,
      "content_sha256": "306d7f804e3dc337dfe5f51f82ab2e9218e3566f039bb5b51fd56564032a9fce",
      "score": 126,
      "content": "on: [push]\n\npermissions:\n  contents: write\n\njobs:\n  publish:\n    runs-on: ubicloud-standard-16\n    permissions:\n      contents: write\n      deployments: write\n    name: Build, Test and Publish to Cloudflare Pages\n    steps:\n      - name: Checkout\n        uses: actions/checkout@v3\n\n      - name: Use Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: \"20.x\"\n\n      - run: npm ci\n        env:\n          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}\n\n      - name: Copy worker assets\n        run: bash copy_workers.sh\n\n      - name: Build\n        run: NODE_OPTIONS=--max_old_space_size=8096 DISABLE_ESLINT_PLUGIN=true npm run build --if-present\n\n      - name: Install Playwright browsers\n        run: npx playwright install --with-deps chromium\n\n      - name: Run Playwright tests\n        # Non-blocking: failures are surfaced via annotations and the uploaded\n        # screenshots, but must not skip the Deploy step below (a flaky/broken\n        # smoke test should never freeze the live demo site).\n        continue-on-error: true\n        run: npx playwright test\n\n      - name: Upload test screenshots\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: playwright-screenshots\n          path: tests/*.png\n\n      - name: Deploy\n        uses: JamesIves/github-pages-deploy-action@v4\n        with:\n          branch: gh-pages\n          folder: build\n"
    },
